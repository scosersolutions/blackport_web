# Dominio público definitivo (activa canonical, Open Graph absoluto y sitemap).
SITE_URL=

# true → muestra en build/preview los placeholders y avisos de datos pendientes.
# En `npm run dev` se muestran siempre. Nunca activar en producción.
PUBLIC_SHOW_PENDING=false

# Analítica (opcional; sin valor no se carga nada).
# Umami Cloud: visitas y clics en botones, sin cookies → no requiere aviso.
PUBLIC_UMAMI_ID=
# Microsoft Clarity: mapas de calor y grabaciones. Usa cookies → se muestra el aviso
# y solo se carga si se acepta.
PUBLIC_CLARITY_ID=
