---
/**
 * Cortina de entrada (primera visita de la sesión, sin reduced-motion).
 * La activa el script en línea de Base.astro con `html.intro-on`; sin JS no existe.
 * Es puramente decorativa: no bloquea clics ni el scroll y se retira sola en ~2 s.
 */
import Logo from './Logo.astro';
import LavaEdge from './lava/LavaEdge.astro';
---

<div class="intro" aria-hidden="true">
  <div class="intro-lava">
    <LavaEdge
      class="intro-drips"
      seed={404}
      base={0}
      amp={0}
      width={1200}
      animate={false}
      fixed={[
        { t: 0.08, len: 120, w: 26 },
        { t: 0.21, len: 260, w: 34 },
        { t: 0.37, len: 90, w: 20 },
        { t: 0.52, len: 330, w: 40 },
        { t: 0.66, len: 150, w: 24 },
        { t: 0.8, len: 230, w: 30 },
        { t: 0.93, len: 70, w: 18 },
      ]}
    />
  </div>
  <div class="intro-ink">
    <div class="intro-logo">
      <Logo width={220} priority />
    </div>
    <span class="intro-bar"></span>
  </div>
</div>

<style>
  .intro {
    display: none;
  }
  :global(html.intro-on) .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    animation: intro-done 0.01s linear 2.3s forwards;
  }
  .intro-ink,
  .intro-lava {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .intro-ink {
    display: grid;
    place-items: center;
    background: var(--c-ink);
    animation: intro-lift 1s var(--ease-liquid) 0.8s forwards;
  }
  .intro-lava {
    background: var(--c-lava);
    animation: intro-lift-far 1.15s var(--ease-liquid) 0.95s forwards;
  }
  .intro-drips {
    position: absolute;
    top: calc(100% - 2px);
    left: 0;
    right: 0;
  }
  .intro-logo {
    animation: intro-logo 0.8s var(--ease-out) both;
  }
  .intro-bar {
    position: absolute;
    left: 50%;
    top: calc(50% + 4.5rem);
    width: 120px;
    height: 2px;
    margin-left: -60px;
    background: var(--c-lava);
    transform-origin: left;
    animation: intro-bar 0.7s var(--ease-out) 0.1s both;
  }
  @keyframes intro-logo {
    from {
      opacity: 0;
      transform: scale(0.92);
      filter: blur(6px);
    }
  }
  @keyframes intro-bar {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes intro-lift {
    to {
      transform: translate3d(0, -100%, 0);
    }
  }
  /* La capa roja sube más para que sus goteos también salgan de pantalla. */
  @keyframes intro-lift-far {
    to {
      transform: translate3d(0, calc(-100% - 70vh), 0);
    }
  }
  @keyframes intro-done {
    to {
      visibility: hidden;
    }
  }
</style>
