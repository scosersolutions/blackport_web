---
/**
 * Entrada «corte»: el logo aparece, una cuchilla roja cruza la pantalla en diagonal
 * y las dos mitades se separan descubriendo el hero.
 * Solo en la primera visita de la sesión y sin reduced-motion (`html.intro-on`, en Base.astro).
 * La coreografía es GSAP (scripts/motion/intro.ts). Si el JS no llega, el script en línea
 * de Base la retira a los 3,5 s. Cualquier tecla, clic, rueda o toque la salta.
 */
import Logo from './Logo.astro';
---

<div class="intro" aria-hidden="true" data-intro>
  <div class="intro-half intro-top" data-intro-top>
    <div class="intro-logo"><Logo width={240} priority /></div>
  </div>
  <div class="intro-half intro-bot" data-intro-bot>
    <div class="intro-logo"><Logo width={240} /></div>
  </div>
  <span class="intro-blade" data-intro-blade></span>
</div>

<style>
  .intro {
    display: none;
  }
  :global(html.intro-on:not(.intro-done)) .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    overflow: hidden;
  }
  /* Diagonal del corte: de (0, 60 %) a (100 %, 40 %). */
  .intro-half {
    position: absolute;
    inset: -2px;
    display: grid;
    place-items: center;
    background: var(--c-ink);
    will-change: transform;
  }
  .intro-top {
    clip-path: polygon(0 0, 100% 0, 100% 40%, 0 60%);
  }
  .intro-bot {
    clip-path: polygon(0 60%, 100% 40%, 100% 100%, 0 100%);
  }
  /* Centrada en la diagonal; el ángulo exacto lo calcula el script según el viewport. */
  .intro-blade {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 160vmax;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--c-lava-bright) 20%, var(--c-lava) 80%, transparent);
    box-shadow: 0 0 24px 2px rgb(240 68 76 / 0.55);
    transform: translate(-50%, -50%) rotate(var(--blade-angle, -11deg));
    clip-path: inset(0 100% 0 0);
  }
</style>
