---
/**
 * Dos cintas tipográficas cruzadas que tapan la costura entre dos secciones.
 * Se desplazan solas y aceleran (o invierten el sentido) con la velocidad del scroll.
 * Decorativas: el contenido real está en las secciones.
 */
interface Props {
  words: string[];
}

const { words } = Astro.props;
// Suficientes repeticiones para cubrir pantallas anchas aunque la cinta esté girada.
const group = [...words, ...words];
---

<div class="marquee-x" aria-hidden="true">
  <div class="band band--ink" data-marquee="-0.6">
    <div class="track">
      {
        [0, 1].map(() => (
          <span class="group">
            {group.map((w) => (
              <span class="word">
                {w}
                <i class="sep" />
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>
  <div class="band band--lava" data-marquee="1">
    <div class="track">
      {
        [0, 1].map(() => (
          <span class="group">
            {group.map((w) => (
              <span class="word">
                {w}
                <i class="sep" />
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>
</div>

<script>
  const bands = Array.from(document.querySelectorAll<HTMLElement>('[data-marquee]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (bands.length && !reduce.matches && 'IntersectionObserver' in window) {
    const state = bands.map((band) => ({
      track: band.querySelector<HTMLElement>('.track')!,
      group: band.querySelector<HTMLElement>('.group')!,
      dir: Number(band.dataset.marquee) || 1,
      x: 0,
    }));
    let visible = false;
    let raf = 0;
    let last = performance.now();
    let lastY = window.scrollY;
    let boost = 0;
    const BASE = 40; // px/s

    const frame = (t: number): void => {
      const dt = Math.min(0.05, (t - last) / 1000);
      last = t;
      const y = window.scrollY;
      // La velocidad del scroll empuja la cinta; decae suavemente.
      boost += ((y - lastY) * 6 - boost) * 0.12;
      lastY = y;
      for (const s of state) {
        const w = s.group.offsetWidth;
        if (!w) continue;
        s.x -= (BASE + Math.abs(boost)) * Math.sign(boost || 1) * s.dir * dt;
        s.x = ((s.x % w) - w) % w;
        s.track.style.transform = `translate3d(${s.x.toFixed(1)}px, 0, 0)`;
      }
      if (visible) raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible) {
        last = performance.now();
        lastY = window.scrollY;
        raf = requestAnimationFrame(frame);
      }
    }).observe(bands[0]);
  }
</script>

<style>
  .marquee-x {
    position: relative;
    z-index: 4;
    height: 0;
    pointer-events: none;
  }
  .band {
    position: absolute;
    left: -10vw;
    width: 120vw;
    top: 0;
    overflow: hidden;
    padding-block: clamp(0.55rem, 1.1vw, 0.95rem);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
  }
  .band--lava {
    background: var(--c-lava);
    color: var(--c-ink);
    transform: translateY(-50%) rotate(-3deg);
  }
  .band--ink {
    background: var(--c-ink);
    color: var(--c-white);
    transform: translateY(-50%) rotate(2.2deg);
    border-block: 1px solid rgb(255 255 255 / 0.12);
  }
  .track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .group {
    display: flex;
    flex: none;
  }
  .word {
    display: inline-flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
    padding-right: clamp(1rem, 2vw, 1.75rem);
    font-size: clamp(1.5rem, 1rem + 2.4vw, 3.2rem);
    font-weight: 860;
    font-stretch: var(--wd-poster);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .band--ink .word:nth-child(even) {
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.85);
  }
  /* Separador: gota. */
  .sep {
    width: 0.38em;
    height: 0.52em;
    flex: none;
    border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    background: currentColor;
    clip-path: polygon(50% 0, 100% 55%, 100% 100%, 0 100%, 0 55%);
  }
  .band--ink .sep {
    background: var(--c-lava);
  }
</style>
