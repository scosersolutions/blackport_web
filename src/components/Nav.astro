---
/**
 * Navegación flotante: sin barra. Tres cápsulas que se leen sobre fondo claro y oscuro:
 * marca (vuelve al inicio) · Instagram + Reservar + Menú (con el progreso de lectura
 * alrededor y el nombre de la escena actual).
 * El menú es un <dialog> a pantalla completa: una cortina de lava cae, la obsidiana
 * la sigue y los enlaces suben; en escritorio cada enlace muestra su foto.
 */
import { getImage } from 'astro:assets';
import Logo from './Logo.astro';
import BookingCta from './ui/BookingCta.astro';
import Icon from './ui/Icon.astro';
import { site } from '@/config/site';
import { valueOf } from '@/lib/pending';
import { aboutPhotos, servicePhotos, gallery, bookingPhoto, type Photo } from '@/data/media';

export interface NavItem {
  href: string;
  label: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const phone = valueOf(site.phone);
const instagram = valueOf(site.instagram);
const address = valueOf(site.address);

const PREVIEW: Record<string, Photo | undefined> = {
  '#sobre': aboutPhotos.main,
  '#galeria': gallery[0],
  '#servicios': servicePhotos.corte,
  '#resenas': bookingPhoto,
  '#visitanos': gallery.find((p) => p.id === 'espejo-puestos'),
};
const links = await Promise.all(
  items.map(async (it) => {
    const p = PREVIEW[it.href];
    const src = p?.src ? (await getImage({ src: p.src, width: 640, format: 'webp' })).src : undefined;
    return { ...it, preview: src, focus: p?.focus ?? '50% 40%' };
  }),
);
---

<header class="nav" data-nav>
  <a href="#inicio" class="cap nav-brand" aria-label={`${site.name}, ir al inicio`}>
    <Logo width={88} priority />
  </a>

  <div class="nav-right">
    {
      instagram && (
        <a class="cap cap-icon" href={instagram.url} target="_blank" rel="noopener noreferrer" aria-label={`Instagram de ${site.name} (pestaña nueva)`}>
          <Icon name="instagram" />
        </a>
      )
    }
    <BookingCta label="Reservar" arrow={false} placement="nav" class="nav-book" />
    <button class="cap nav-menu" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
      <span class="nav-where" aria-hidden="true"><span data-nav-where>Inicio</span></span>
      <span class="nav-menu-label">Menú</span>
      <span class="nav-dial" aria-hidden="true">
        <svg viewBox="0 0 36 36" focusable="false">
          <circle class="dial-track" cx="18" cy="18" r="16.5"></circle>
          <circle class="dial-fill" cx="18" cy="18" r="16.5" pathLength="1" data-nav-progress></circle>
        </svg>
        <span class="burger"><i></i><i></i></span>
      </span>
    </button>
  </div>
</header>

<dialog class="menu" id="menu" aria-label="Menú" data-menu>
  <svg class="menu-curtain" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="mc-lava" data-mc="lava" d="M0 0Z"></path>
    <path class="mc-rock" data-mc="rock" d="M0 0Z"></path>
  </svg>

  <div class="menu-inner">
    <div class="menu-top">
      <Logo width={104} />
      <button class="menu-close" type="button" data-menu-close>
        <span>Cerrar</span>
        <Icon name="close" />
      </button>
    </div>

    <nav class="menu-nav" aria-label="Secciones">
      <ol>
        {
          links.map((it, i) => (
            <li class="menu-item" style={`--i:${i}`}>
              <a href={it.href} data-menu-link data-spy data-preview={it.preview} data-focus={it.focus}>
                <span class="menu-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="menu-label">{it.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <figure class="menu-preview" aria-hidden="true">
      <img alt="" data-menu-preview />
    </figure>

    <div class="menu-foot">
      <BookingCta size="lg" placement="menu" />
      <div class="menu-contact">
        {address && <p>{address.street}, {address.postalCode} {address.locality}</p>}
        {phone && <a href={`tel:${phone.e164}`}><Icon name="phone" /> {phone.display}</a>}
        {
          instagram && (
            <a href={instagram.url} target="_blank" rel="noopener noreferrer">
              <Icon name="instagram" /> @{instagram.handle}
              <span class="sr-only">(pestaña nueva)</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</dialog>

<script>
  import { setupNav } from '@/scripts/nav';
  setupNav();
</script>

<style>
  .nav {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: clamp(0.75rem, 1.6vw, 1.25rem) var(--gutter);
    pointer-events: none;
  }
  .nav > * {
    pointer-events: auto;
  }
  /* Cápsula: obsidiana translúcida, legible sobre ceniza, foto o magma. */
  .cap {
    display: inline-flex;
    align-items: center;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    background: rgb(7 7 7 / 0.9);
    color: var(--c-white);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    backdrop-filter: blur(12px) saturate(1.3);
    transition:
      background 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .cap:hover {
    border-color: rgb(255 255 255 / 0.3);
  }
  .nav-brand {
    padding-inline: 1rem;
  }
  .nav-brand :global(.logo) {
    transition: transform 0.5s var(--ease-out);
  }
  .nav-brand:hover :global(.logo) {
    transform: scale(1.05) rotate(-2deg);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cap-icon {
    justify-content: center;
    width: 48px;
  }
  .cap-icon :global(.icon) {
    width: 21px;
    height: 21px;
    transition: transform 0.5s var(--ease-out);
  }
  .cap-icon:hover {
    background: var(--c-lava);
    border-color: var(--c-lava);
  }
  .cap-icon:hover :global(.icon) {
    transform: rotate(-8deg) scale(1.08);
  }
  .nav-right :global(.nav-book) {
    min-height: 48px;
    padding: 0.7rem 1.35rem;
    font-size: 0.72rem;
  }

  .nav-menu {
    gap: 0.75rem;
    padding: 0 0.3rem 0 1.1rem;
    font-size: 0.78rem;
    font-weight: 650;
  }
  /* Nombre de la escena actual: rueda hacia arriba al cambiar. */
  .nav-where {
    display: inline-flex;
    height: 1.2em;
    overflow: hidden;
    color: var(--c-ash);
    font-weight: 500;
  }
  .nav-where span {
    display: block;
    line-height: 1.2;
  }
  .nav-where::after {
    content: '/';
    margin-left: 0.6rem;
  }
  .nav-dial {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
  }
  .nav-dial svg {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .dial-track,
  .dial-fill {
    fill: none;
    stroke-width: 1.5;
  }
  .dial-track {
    stroke: rgb(255 255 255 / 0.16);
  }
  .dial-fill {
    stroke: var(--c-lava-bright);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .burger {
    display: grid;
    gap: 5px;
    width: 16px;
  }
  .burger i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }
  .burger i:last-child {
    width: 60%;
    justify-self: end;
  }
  .nav-menu:hover .burger i:last-child {
    transform: scaleX(1.66);
    transform-origin: right;
  }

  @media (max-width: 1023px) {
    .nav-where {
      display: none;
    }
  }
  @media (max-width: 599px) {
    /* En móvil reservar vive en la barra inferior; aquí, marca + Instagram + menú. */
    .nav-right :global(.nav-book) {
      display: none;
    }
    .nav-menu-label {
      display: none;
    }
    .nav-menu {
      width: 48px;
      padding: 0;
      justify-content: center;
    }
  }

  /* ───────── Menú ───────── */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--c-white);
    overflow: hidden;
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu[open] {
    display: block;
  }
  .menu-curtain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .mc-lava {
    fill: var(--c-lava);
  }
  .mc-rock {
    fill: var(--c-ink);
  }
  /* Sin la coreografía (reduced-motion o antes de cargar GSAP): fondo sólido y fundido. */
  .menu:not(.is-animated) {
    background: var(--c-ink);
  }
  .menu:not(.is-animated)[open] {
    animation: menu-fade 0.3s ease both;
  }
  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }

  .menu-inner {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    grid-template-areas: 'top top' 'nav preview' 'foot preview';
    column-gap: 4rem;
    padding: clamp(0.75rem, 1.6vw, 1.25rem) var(--gutter) clamp(1.25rem, 3vw, 2.5rem);
    overflow-y: auto;
  }
  .menu-top {
    grid-area: top;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding-left: 1rem;
  }
  .menu-close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 48px;
    padding: 0 0.6rem 0 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 650;
    transition: background 0.3s, border-color 0.3s;
  }
  .menu-close:hover {
    background: var(--c-lava);
    border-color: var(--c-lava);
  }
  .menu-close :global(.icon) {
    width: 22px;
    height: 22px;
  }
  .menu-nav {
    grid-area: nav;
    align-self: center;
    padding-block: 2rem;
  }
  .menu-nav a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    padding-block: 0.15rem;
  }
  .menu-num {
    min-width: 2ch;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--c-ash);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s;
  }
  .menu-label {
    display: block;
    font-size: clamp(2.6rem, 1rem + 5.4vw, 6.4rem);
    font-weight: 880;
    font-stretch: 62%;
    line-height: 0.98;
    text-transform: uppercase;
    transition:
      color 0.35s,
      transform 0.6s var(--ease-out),
      font-stretch 0.6s var(--ease-out);
  }
  .menu-nav a:hover .menu-label,
  .menu-nav a:focus-visible .menu-label {
    color: var(--c-lava-bright);
    transform: translateX(0.12em);
    font-stretch: 78%;
  }
  .menu-nav a:hover .menu-num,
  .menu-nav a[aria-current] .menu-num {
    color: var(--c-lava-bright);
  }
  .menu-nav a[aria-current] .menu-label {
    -webkit-text-stroke: 1.5px var(--c-bone);
    color: transparent;
  }
  .menu-preview {
    grid-area: preview;
    align-self: center;
    justify-self: end;
    width: min(100%, 30rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--c-ink-2);
    clip-path: inset(50% 0 50% 0);
    transition: clip-path 0.7s var(--ease-liquid);
  }
  .menu-preview.is-on {
    clip-path: inset(0 0 0 0);
  }
  .menu-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-mono);
    transform: scale(1.12);
    transition: transform 1.2s var(--ease-out);
  }
  .menu-preview.is-on img {
    transform: none;
  }
  .menu-foot {
    grid-area: foot;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }
  .menu-contact {
    display: grid;
    gap: 0.25rem;
    color: var(--c-ash);
    font-size: var(--fs-small);
  }
  .menu-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 40px;
    color: var(--c-white);
    font-weight: 600;
  }
  .menu-contact a:hover {
    color: var(--c-lava-bright);
  }
  .menu-contact :global(.icon) {
    width: 18px;
    color: var(--c-lava-bright);
  }

  @media (max-width: 899px) {
    .menu-inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'top' 'nav' 'foot';
    }
    .menu-preview {
      display: none;
    }
    .menu-foot {
      flex-direction: column;
      align-items: stretch;
    }
    .menu-foot :global(.btn) {
      width: 100%;
    }
  }
</style>
