---
import Logo from './Logo.astro';
import BookingCta from './ui/BookingCta.astro';
import Icon from './ui/Icon.astro';

export interface NavItem {
  href: string;
  label: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a href="#inicio" class="nav-logo" aria-label="BLACKPORT, ir al inicio">
      <Logo width={118} priority />
    </a>

    <nav class="nav-links" aria-label="Principal">
      <ul>
        {
          items.map((it) => (
            <li>
              <a href={it.href}>{it.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-cta">
      <BookingCta label="Reservar cita" variant="outline-lava" arrow={false} placement="nav" />
    </div>

    <button class="nav-toggle" type="button" aria-haspopup="dialog" aria-controls="menu-movil" data-menu-open>
      <span class="sr-only">Abrir menú</span>
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<dialog class="menu" id="menu-movil" aria-label="Menú" data-menu>
  <div class="menu-top wrap">
    <Logo width={118} />
    <button class="menu-close" type="button" data-menu-close>
      <Icon name="close" />
      <span class="sr-only">Cerrar menú</span>
    </button>
  </div>
  <nav class="menu-body wrap" aria-label="Menú móvil">
    <ol>
      {
        items.map((it, i) => (
          <li>
            <a href={it.href} data-menu-link>
              <span class="menu-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu-label">{it.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <BookingCta size="lg" placement="menu" />
  </nav>
</dialog>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  if (nav) {
    const onScroll = (): void => {
      nav.classList.toggle('is-solid', window.scrollY > 24);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (menu && openBtn) {
    const close = (): void => menu.close();
    openBtn.addEventListener('click', () => {
      menu.showModal();
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', close));
    // Cierre al pulsar fuera del contenido (backdrop).
    menu.addEventListener('click', (e) => {
      if (e.target === menu) close();
    });
    // Si se pasa a escritorio con el menú abierto, cerrarlo.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && menu.open) close();
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    color: var(--c-white);
    transition:
      background-color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      height 0.4s var(--ease-out);
  }
  .nav::before {
    /* Degradado de legibilidad sobre el hero, antes de solidificarse. */
    content: '';
    position: absolute;
    inset: 0 0 -30px;
    background: linear-gradient(rgb(9 9 9 / 0.7), transparent);
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .nav.is-solid {
    background: rgb(9 9 9 / 0.94);
    box-shadow: 0 1px 0 var(--c-line-dark);
  }
  .nav.is-solid::before {
    opacity: 0;
  }
  .nav-inner {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-logo {
    transition:
      opacity 0.4s var(--ease-out),
      visibility 0.4s;
    padding-block: 0.4rem;
    margin-right: auto;
  }
  .nav-links ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2.1rem);
  }
  .nav-links a {
    position: relative;
    display: inline-block;
    padding-block: 0.75rem;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
    transition: opacity 0.3s;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.45rem;
    height: 2px;
    background: var(--c-lava);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  .nav-links a:hover {
    opacity: 1;
  }
  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-cta :global(.btn) {
    min-height: 42px;
    padding: 0.7rem 1.25rem;
    font-size: 0.7rem;
  }

  .nav-toggle {
    display: none;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    place-items: center;
  }
  .burger {
    display: grid;
    gap: 7px;
    width: 26px;
  }
  .burger i {
    display: block;
    height: 2px;
    background: currentColor;
  }
  .burger i:last-child {
    width: 62%;
    justify-self: end;
  }

  /* En escritorio el hero ya muestra el logo: el de la barra aparece al hacer scroll. */
  @media (min-width: 900px) {
    .nav:not(.is-solid) .nav-logo {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (max-width: 1023px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .nav-toggle {
      display: grid;
    }
  }

  /* ───────── Menú móvil ───────── */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-ink);
    color: var(--c-white);
    overflow-y: auto;
  }
  .menu::backdrop {
    background: var(--c-ink);
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
    animation: menu-in 0.45s var(--ease-out);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
  }
  .menu-close {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -12px;
  }
  .menu-close :global(.icon) {
    width: 28px;
    height: 28px;
  }
  .menu-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 2rem 3rem;
  }
  .menu-body ol {
    display: grid;
  }
  .menu-body a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--c-line-dark);
  }
  .menu-num {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--c-lava-bright);
    letter-spacing: 0.1em;
  }
  .menu-label {
    font-size: clamp(1.8rem, 8vw, 2.6rem);
    font-weight: 700;
    font-stretch: 92%;
    text-transform: uppercase;
    line-height: 1.1;
  }
</style>
