---
/** Roca volcánica con grietas incandescentes. Remate inferior de secciones oscuras. */
import { lavaCracks } from '@/lib/lava';
import { scopeAttrs } from '@/lib/scope';

interface Props {
  seed: number;
  height?: number;
  class?: string;
}

const { seed, height = 220, class: className } = Astro.props;
const scope = scopeAttrs(Astro.props);
const c = lavaCracks(seed, 1440, height);
const gid = `lc-${seed}`;
---

<div class:list={['lava-cracks', className]} aria-hidden="true" data-lava {...scope}>
  <svg viewBox={`0 0 ${c.width} ${c.height}`} preserveAspectRatio="xMidYMax slice" focusable="false">
    <defs>
      <linearGradient id={`${gid}-rock`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--c-ink)" stop-opacity="0" />
        <stop offset="0.5" stop-color="#0b0606" stop-opacity="0.9" />
        <stop offset="1" stop-color="#140808" />
      </linearGradient>
      <radialGradient id={`${gid}-heat`}>
        <stop offset="0" stop-color="var(--c-lava)" stop-opacity="0.9" />
        <stop offset="1" stop-color="var(--c-lava)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width={c.width} height={c.height} fill={`url(#${gid}-rock)`} />
    <g class="cracks-heat">
      {
        c.hotspots.map((h) => (
          <ellipse cx={h.cx.toFixed(0)} cy={h.cy.toFixed(0)} rx={h.rx.toFixed(0)} ry={h.ry.toFixed(0)} fill={`url(#${gid}-heat)`} opacity={h.o.toFixed(2)} />
        ))
      }
    </g>
    <g fill="none" stroke-linejoin="round" stroke-linecap="round">
      {c.veins.map((d) => <path d={d} stroke="var(--c-lava)" stroke-width="16" opacity="0.07" />)}
      {c.veins.map((d) => <path d={d} stroke="var(--c-lava-deep)" stroke-width="4.5" opacity="0.9" />)}
      {c.branches.map((d) => <path d={d} stroke="var(--c-lava)" stroke-width="1.3" opacity="0.55" />)}
      {c.veins.map((d) => <path d={d} stroke="var(--c-lava)" stroke-width="2" opacity="0.95" />)}
      {c.veins.map((d, i) => i % 3 === 0 && <path d={d} stroke="var(--c-heat)" stroke-width="0.9" opacity="0.85" />)}
    </g>
  </svg>
</div>

<style>
  .lava-cracks {
    pointer-events: none;
    line-height: 0;
  }
  .lava-cracks svg {
    display: block;
    width: 100%;
    height: clamp(120px, 16vw, 220px);
  }
</style>
