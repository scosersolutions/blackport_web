---
/**
 * Franja derretida con goteos. Cuelga desde el borde superior de su contenedor.
 * tone='lava' usa el rojo líquido con brillo; el resto, color plano de superficie
 * (para que una sección «gotee» sobre la siguiente).
 */
import { meltedEdge, type EdgeOptions } from '@/lib/lava';
import { scopeAttrs } from '@/lib/scope';

type Tone = 'lava' | 'ink' | 'ink-2' | 'bone' | 'white';

interface Props extends EdgeOptions {
  tone?: Tone;
  /** Ancho mínimo renderizado; en móvil se recorta el centro en vez de encoger. */
  minWidth?: string;
  animate?: boolean;
  class?: string;
}

const { tone = 'lava', minWidth = '900px', animate = true, class: className, ...rest } = Astro.props;
const scope = scopeAttrs(rest);
const opts = Object.fromEntries(Object.entries(rest).filter(([k]) => !k.startsWith('data-'))) as unknown as EdgeOptions;
const shape = meltedEdge(opts);
const gid = `lv-${opts.seed}`;
const isLava = tone === 'lava';
const fill = isLava ? `url(#${gid})` : `var(--c-${tone})`;
---

<div
  class:list={['lava-edge', className]}
  style={`--lava-min:${minWidth}`}
  aria-hidden="true"
  data-lava={animate ? '' : undefined}
  {...scope}
>
  <svg viewBox={`0 0 ${shape.width} ${shape.height}`} focusable="false">
    {
      isLava && (
        <defs>
          <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--c-lava)" />
            <stop offset="0.7" stop-color="var(--c-lava)" />
            <stop offset="1" stop-color="var(--c-lava-deep)" />
          </linearGradient>
        </defs>
      )
    }
    {
      shape.drips.map((d) => (
        <g class="drip" style={`--d:${d.delay.toFixed(2)}s`}>
          <path d={d.d} fill={fill} />
          {isLava && (
            <ellipse
              class="drip-gloss"
              cx={d.highlight.cx.toFixed(1)}
              cy={d.highlight.cy.toFixed(1)}
              rx={d.highlight.rx.toFixed(1)}
              ry={d.highlight.ry.toFixed(1)}
            />
          )}
        </g>
      ))
    }
    <path d={shape.band} fill={fill} />
  </svg>
</div>

<style>
  .lava-edge {
    overflow: hidden;
    pointer-events: none;
    line-height: 0;
  }
  .lava-edge svg {
    display: block;
    width: max(100%, var(--lava-min));
    height: auto;
    margin-left: 50%;
    transform: translateX(-50%);
    overflow: visible;
  }
</style>
