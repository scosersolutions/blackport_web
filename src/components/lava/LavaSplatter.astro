---
/** Salpicadura pequeña y gráfica. Úsese con moderación. */
import { splatter } from '@/lib/lava';
import { scopeAttrs } from '@/lib/scope';

interface Props {
  seed: number;
  class?: string;
}

const { seed, class: className } = Astro.props;
const scope = scopeAttrs(Astro.props);
const s = splatter(seed);
---

<svg
  class:list={['lava-splat', className]}
  viewBox={`0 0 ${s.size} ${s.size}`}
  aria-hidden="true"
  focusable="false"
  data-lava
  {...scope}
>
  <path d={s.blob} fill="var(--c-lava)" />
  {
    s.dots.map((d) => (
      <ellipse
        cx={d.cx.toFixed(1)}
        cy={d.cy.toFixed(1)}
        rx={d.rx.toFixed(1)}
        ry={d.ry.toFixed(1)}
        transform={`rotate(${d.rot.toFixed(0)} ${d.cx.toFixed(1)} ${d.cy.toFixed(1)})`}
        fill="var(--c-lava)"
      />
    ))
  }
</svg>

<style>
  .lava-splat {
    display: block;
    pointer-events: none;
    overflow: visible;
  }
</style>
