---
/* Copy de marca provisional (sin datos biográficos ni históricos): validar con BLACKPORT. */
import { Image } from 'astro:assets';
import MediaFrame from '../ui/MediaFrame.astro';
import Icon from '../ui/Icon.astro';
import LavaFlow from '../lava/LavaFlow.astro';
import { aboutPhotos, aboutInline } from '@/data/media';

const values = ['Estilo', 'Precisión', 'Actitud'];
const [inlineA, inlineB] = aboutInline;
---

<section id="sobre" class="about surface-light" aria-labelledby="about-title" data-scene="about">
  <LavaFlow class="about-lava" seed={7} count={12} maxLen={150} maxW={28} />
  <div class="wrap">
    <p class="eyebrow" data-reveal="rise">Sobre BLACKPORT</p>

    <h2 id="about-title" class="about-title" data-split="chars">
      <span class="line-mask"><span>Disciplina, {inlineA?.src && <span class="pill photo-mono" aria-hidden="true"><Image src={inlineA.src} alt="" widths={[240, 360]} sizes="12vw" style={`object-position:${inlineA.focus}`} /></span>}</span></span>
      <span class="line-mask"><span><span class="outline">estilo</span> {inlineB?.src && <span class="pill pill--b photo-mono" aria-hidden="true"><Image src={inlineB.src} alt="" widths={[240, 360]} sizes="12vw" style={`object-position:${inlineB.focus}`} /></span>} y </span></span>
      <span class="line-mask"><span class="lava-text">actitud. </span></span>
    </h2>

    <div class="about-grid">
      <div class="about-text">
        <p class="about-body" data-split="fill">
          En BLACKPORT cada corte tiene un propósito. Escuchamos lo que buscas, trabajamos con precisión y cuidamos
          cada detalle —del degradado al color— para que salgas con tu mejor versión.
        </p>
        <ol class="about-values" aria-label="Valores">
          {
            values.map((v) => (
              <li>
                <span class="v-name">{v}</span>
              </li>
            ))
          }
        </ol>
        <a class="link-arrow" href="#galeria" data-reveal="rise" style="--delay:.3s">
          Ver el trabajo <Icon name="arrow" class="arrow" />
        </a>
      </div>

      <figure class="about-portrait" data-tilt>
        <div class="about-portrait-frame photo-mono" data-portrait>
          <MediaFrame photo={aboutPhotos.main} sizes="(min-width: 900px) 36vw, 84vw" widths={[480, 853]} />
        </div>
      </figure>

      <figure class="about-detail" data-detail>
        <div class="about-detail-frame photo-mono">
          <MediaFrame photo={aboutPhotos.detail} sizes="(min-width: 900px) 22vw, 52vw" widths={[480, 853]} />
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    z-index: 1;
    /* Reserva el espacio de la lava que cae desde el hero (ver LavaFlow). */
    padding-top: clamp(12rem, 22vw, 21rem);
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }
  .about-lava {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
  }

  /* Titular de cartel a todo el ancho con miniaturas entre palabras. */
  .about-title {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    font-size: clamp(3rem, 0.6rem + 10.2vw, 11.5rem);
    font-weight: 860;
    font-stretch: var(--wd-poster);
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .about-title .line-mask:nth-child(2) {
    padding-left: 12vw;
  }
  .about-title .line-mask:nth-child(3) {
    padding-left: 4vw;
  }
  .pill {
    display: inline-block;
    width: 1.55em;
    height: 0.7em;
    margin-inline: 0.06em 0.12em;
    vertical-align: 0.04em;
    border-radius: 999px;
    overflow: hidden;
    background: var(--c-ink-2);
  }
  .pill--b {
    width: 1.1em;
  }
  .pill :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease-out) 0.3s;
  }

  .about-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    margin-top: clamp(3.5rem, 7vw, 6.5rem);
  }
  .about-text {
    grid-column: 1 / span 5;
    grid-row: 1;
    display: grid;
    gap: 2.25rem;
    align-content: start;
    justify-items: start;
    padding-top: clamp(1rem, 4vw, 4rem);
  }
  .about-body {
    max-width: 40ch;
    color: var(--c-ink);
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    font-weight: 500;
    line-height: 1.4;
  }
  .about-values {
    width: 100%;
    border-top: 1px solid var(--c-line-light);
  }
  .about-values li {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--c-line-light);
  }
  .v-name {
    font-size: clamp(1.6rem, 1rem + 1.8vw, 2.6rem);
    font-weight: 820;
    font-stretch: var(--wd-tight);
    line-height: 1;
    text-transform: uppercase;
  }

  .about-portrait {
    position: relative;
    perspective: 900px;
    grid-column: 7 / span 5;
    grid-row: 1 / span 2;
  }
  .about-portrait-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--c-ink-2);
  }
  .about-portrait-frame :global(.media) {
    transform-origin: 50% 40%;
  }

  .about-detail {
    position: relative;
    z-index: 1;
    grid-column: 10 / span 3;
    grid-row: 2;
    margin-top: -38%;
    margin-right: calc(var(--gutter) * -0.5);
  }
  .about-detail-frame {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--c-ink-2);
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.55);
  }

  @media (max-width: 899px) {
    .about-title .line-mask:nth-child(2) {
      padding-left: 0;
    }
    .about-title .line-mask:nth-child(3) {
      padding-left: 0;
    }
    .about-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 3rem;
    }
    .about-text {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .about-portrait {
      grid-column: 1 / span 5;
      grid-row: 2;
    }
    .about-detail {
      grid-column: 3 / -1;
      grid-row: 3;
      margin-top: -2rem;
      margin-right: 0;
    }
  }
</style>
