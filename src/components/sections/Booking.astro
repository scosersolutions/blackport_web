---
/**
 * Reserva: la escena de conversión, sobre un lago de lava (WebGL, lienzo «lake»)
 * que se queda fijo mientras el contenido pasa por encima. Su borde superior sube
 * como un frente de lava ondulado (scenes.ts) y su calor crece al entrar.
 * Sin WebGL: degradado incandescente estático. El CTA no depende de nada de esto.
 */
import BookingCta from '../ui/BookingCta.astro';
import Icon from '../ui/Icon.astro';
import { BOOKSY_URL } from '@/config/site';

const ring = 'Reserva en Booksy · Reserva en Booksy · ';
---

<section id="reservar" class="booking" aria-labelledby="booking-title" data-scene="booking">
  <div class="booking-bg" aria-hidden="true">
    <canvas class="booking-magma" data-magma="lake"></canvas>
    <div class="booking-shade"></div>
  </div>

  <div class="booking-inner wrap">
    <div class="booking-main">
      <p class="eyebrow" data-reveal="rise">Reservas en Booksy</p>
      <h2 id="booking-title" class="booking-title" data-split="slide">
        <span class="line-mask"><span>Tu próximo </span></span>
        <span class="line-mask"><span><span class="outline">corte</span> </span></span>
        <span class="line-mask"><span>empieza </span></span>
        <span class="line-mask"><span class="booking-hot">aquí. </span></span>
      </h2>
      <p class="booking-text" data-reveal="rise" style="--delay:.15s">
        Elige servicio, día y hora directamente en Booksy, a cualquier hora del día.
      </p>
      <div class="booking-cta" data-reveal="rise" style="--delay:.25s">
        <BookingCta size="lg" placement="booking" magnetic />
      </div>
    </div>

    {
      BOOKSY_URL && (
        <a class="orb" href={BOOKSY_URL} target="_blank" rel="noopener noreferrer" data-magnetic="0.3" data-cta="booking" data-placement="booking-orb">
          <svg class="orb-ring" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
            <defs>
              <path id="orb-path" d="M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0" />
            </defs>
            <text>
              <textPath href="#orb-path" textLength="486" lengthAdjust="spacing">{ring}</textPath>
            </text>
          </svg>
          <span class="orb-core">
            <span>Reservar</span>
            <Icon name="arrow" class="arrow" />
          </span>
          <span class="sr-only">en Booksy (pestaña nueva)</span>
        </a>
      )
    }

  </div>
</section>

<style>
  .booking {
    --pad-top: clamp(8rem, 14vw, 13rem);
    position: relative;
    z-index: 1;
    /* Se solapa con el final de la carta: ahí sube el frente de lava (scenes.ts). */
    margin-top: calc(var(--front-rise) * -1);
    padding-block: var(--pad-top) clamp(9rem, 15vw, 14rem);
    background: #160304;
    color: var(--c-white);
    overflow: clip;
    isolation: isolate;
  }
  /* El lago queda fijo en pantalla mientras la sección pasa (sticky + margen negativo). */
  .booking-bg {
    position: sticky;
    top: 0;
    z-index: -1;
    height: 100lvh;
    margin-top: calc(var(--pad-top) * -1);
    margin-bottom: calc(var(--pad-top) - 100lvh);
    background:
      radial-gradient(40% 30% at 70% 35%, rgb(255 90 30 / 0.35), transparent 70%),
      radial-gradient(50% 40% at 20% 80%, rgb(204 39 49 / 0.4), transparent 70%),
      #1a0405;
  }
  .booking-magma {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Velo de legibilidad: el texto siempre sobre costra oscura, nunca sobre el rojo. */
  .booking-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(7 7 7 / 0.82) 0%, rgb(7 7 7 / 0.55) 48%, rgb(7 7 7 / 0.1) 75%),
      linear-gradient(0deg, rgb(7 7 7 / 0.5), transparent 40%);
  }

  .booking-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    grid-template-areas: 'main orb';
    column-gap: 3rem;
    row-gap: clamp(3rem, 6vw, 5rem);
  }
  .booking-main {
    grid-area: main;
  }
  .booking .eyebrow {
    color: rgb(255 255 255 / 0.75);
  }
  .booking-title {
    margin-block: 1.4rem 1.6rem;
    font-size: clamp(3.2rem, 0.8rem + 8.6vw, 10rem);
    font-weight: 880;
    font-stretch: var(--wd-poster);
    line-height: 0.88;
    text-transform: uppercase;
  }
  .booking-title :global(.outline) {
    -webkit-text-stroke-color: rgb(255 255 255 / 0.9);
  }
  .booking-hot {
    color: var(--c-lava-bright);
    text-shadow: 0 0 40px rgb(255 90 30 / 0.45);
  }
  .booking-text {
    max-width: 38ch;
    color: rgb(255 255 255 / 0.82);
    font-size: var(--fs-lead);
  }
  .booking-cta {
    margin-top: 2.25rem;
  }

  /* ── Orbe de reserva: anillo de texto que gira con el scroll ── */
  .orb {
    grid-area: orb;
    align-self: center;
    justify-self: center;
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(200px, 18vw, 260px);
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--c-white);
    transition: transform 0.45s var(--ease-out);
  }
  .orb-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-size: 15.5px;
    font-weight: 700;
    text-transform: uppercase;
    fill: currentColor;
  }
  .orb-core {
    position: relative;
    display: grid;
    place-items: center;
    gap: 0.2rem;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c-lava);
    box-shadow: 0 0 60px rgb(255 90 30 / 0.35);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    overflow: hidden;
    isolation: isolate;
    transition: color 0.4s var(--ease-out);
  }
  .orb-core::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c-white);
    border-radius: inherit;
    transform: scale(0);
    transition: transform 0.5s var(--ease-liquid);
  }
  .orb:hover .orb-core,
  .orb:focus-visible .orb-core {
    color: var(--c-ink);
  }
  .orb:hover .orb-core::before,
  .orb:focus-visible .orb-core::before {
    transform: none;
  }
  .orb-core :global(.arrow) {
    width: 22px;
    transform: rotate(-45deg);
    transition: transform 0.45s var(--ease-out);
  }
  .orb:hover .orb-core :global(.arrow) {
    transform: rotate(0deg);
  }
  .orb:focus-visible {
    outline-offset: 6px;
  }

  @media (max-width: 899px) {
    .booking-shade {
      background: linear-gradient(0deg, rgb(7 7 7 / 0.7), rgb(7 7 7 / 0.55) 50%, rgb(7 7 7 / 0.35));
    }
    .booking-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'main';
    }
    .orb {
      display: none;
    }
    .booking-cta :global(.btn) {
      width: 100%;
    }
  }
</style>
