---
import { getImage } from 'astro:assets';
import MediaFrame from '../ui/MediaFrame.astro';
import Icon from '../ui/Icon.astro';
import BookingCta from '../ui/BookingCta.astro';
import LavaEdge from '../lava/LavaEdge.astro';
import { gallery, CATEGORY_LABEL } from '@/data/media';
import { SHOW_PENDING } from '@/lib/pending';
import { BOOKSY_URL } from '@/config/site';

const items = await Promise.all(
  gallery
    .filter((p) => p.src || SHOW_PENDING)
    .map(async (p) => ({
      photo: p,
      large: p.src ? (await getImage({ src: p.src, width: Math.min(1280, p.src.width), format: 'webp' })).src : undefined,
    })),
);
const viewable = items.filter((i) => i.large);
const total = String(items.length).padStart(2, '0');
// Ritmo del recorrido: alturas y alineaciones alternas.
const VARIANTS = ['tall', 'low', 'mid', 'high', 'tall', 'low', 'mid', 'high', 'tall'];
---

<section id="galeria" class="gallery surface-light" aria-labelledby="gallery-title" data-hscroll>
  <div class="g-pin">
    <header class="g-head wrap">
      <div>
        <p class="eyebrow" data-reveal="rise"><span class="idx">(03)</span> Galería</p>
        <h2 id="gallery-title" class="h2" data-reveal="lines">
          <span class="line-mask"><span>Cortes, estilo, </span></span>
          <span class="line-mask"><span class="lava-text">personalidad. </span></span>
        </h2>
      </div>
      <div class="g-aside" data-reveal="rise" style="--delay:.15s">
        <p class="muted">El detalle también es parte del corte. Trabajo real, hecho en BLACKPORT.</p>
        <div class="g-controls">
          <p class="g-counter" aria-hidden="true">
            <span data-g-current>01</span> / {total}
          </p>
          <span class="g-bar" aria-hidden="true"><i data-g-bar></i></span>
          <div class="g-nav">
            <button type="button" class="g-arrow" data-g-prev>
              <Icon name="prev" />
              <span class="sr-only">Fotos anteriores</span>
            </button>
            <button type="button" class="g-arrow" data-g-next>
              <Icon name="next" />
              <span class="sr-only">Fotos siguientes</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="g-viewport" data-g-viewport>
      <ul class="g-track" data-g-track>
        {
          items.map(({ photo, large }, i) => (
            <li class={`g-item g-item--${VARIANTS[i % VARIANTS.length]}`} data-g-item>
              <div class="g-frame" data-reveal="frame" style={`--delay:${((i % 3) * 0.08).toFixed(2)}s`}>
                {large ? (
                  <button
                    type="button"
                    class="g-btn"
                    data-gallery-open={viewable.findIndex((v) => v.photo.id === photo.id)}
                    aria-label={`Ampliar: ${photo.alt}`}
                  >
                    <MediaFrame photo={photo} sizes="(min-width: 900px) 30vw, 78vw" widths={[400, 640, 853]} />
                    <span class="g-zoom" aria-hidden="true">
                      <Icon name="plus" />
                    </span>
                  </button>
                ) : (
                  <MediaFrame photo={photo} sizes="30vw" />
                )}
              </div>
              <p class="g-cap" aria-hidden="true">
                <span>{String(i + 1).padStart(2, '0')}</span>
                {CATEGORY_LABEL[photo.category]}
              </p>
              {i === 2 && (
                <LavaEdge
                  class="g-drip"
                  seed={123}
                  base={0}
                  amp={0}
                  width={200}
                  minWidth="0px"
                  fixed={[
                    { t: 0.35, len: 90, w: 10 },
                    { t: 0.7, len: 40, w: 7 },
                  ]}
                />
              )}
            </li>
          ))
        }
        {
          BOOKSY_URL && (
            <li class="g-end">
              <p class="g-end-title">
                ¿El <span class="outline">siguiente</span>
                <br />
                <span class="lava-text">corte?</span>
              </p>
              <BookingCta label="Reservar cita" placement="gallery" />
            </li>
          )
        }
      </ul>
    </div>
  </div>

  {
    viewable.length > 0 && (
      <dialog class="lightbox" aria-label="Galería ampliada" data-lightbox>
        <figure class="lb-figure">
          <img class="lb-img" alt="" data-lb-img />
          <figcaption class="lb-caption">
            <span data-lb-caption />
            <span class="lb-count" aria-live="polite" data-lb-count />
          </figcaption>
        </figure>
        <button class="lb-btn lb-close" type="button" data-lb-close>
          <Icon name="close" />
          <span class="sr-only">Cerrar galería</span>
        </button>
        <button class="lb-btn lb-prev" type="button" data-lb-prev>
          <Icon name="prev" />
          <span class="sr-only">Foto anterior</span>
        </button>
        <button class="lb-btn lb-next" type="button" data-lb-next>
          <Icon name="next" />
          <span class="sr-only">Foto siguiente</span>
        </button>
        <script
          type="application/json"
          data-lb-data
          set:html={JSON.stringify(viewable.map((v) => ({ src: v.large, alt: v.photo.alt })))}
        />
      </dialog>
    )
  }
</section>

<script>
  /* ── Recorrido horizontal ──
     Escritorio con movimiento: la sección se fija y el scroll vertical desplaza la pista.
     Móvil o reduced-motion: carrusel nativo con scroll horizontal y snap. */
  const section = document.querySelector<HTMLElement>('[data-hscroll]');
  const viewport = section?.querySelector<HTMLElement>('[data-g-viewport]');
  const track = section?.querySelector<HTMLElement>('[data-g-track]');
  if (section && viewport && track) {
    const items = Array.from(track.querySelectorAll<HTMLElement>('[data-g-item]'));
    const current = section.querySelector<HTMLElement>('[data-g-current]');
    const bar = section.querySelector<HTMLElement>('[data-g-bar]');
    const pinQuery = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
    let pinned = false;
    let maxX = 0;
    let queued = false;

    const setProgress = (p: number): void => {
      if (bar) bar.style.transform = `scaleX(${Math.max(0.04, p).toFixed(4)})`;
      const idx = Math.min(items.length - 1, Math.round(p * (items.length - 1)));
      if (current) current.textContent = String(idx + 1).padStart(2, '0');
    };

    const measure = (): void => {
      pinned = pinQuery.matches;
      section.classList.toggle('is-pinned', pinned);
      if (!pinned) {
        section.style.height = '';
        track.style.transform = '';
        return;
      }
      maxX = Math.max(0, track.scrollWidth - viewport.clientWidth);
      // Altura = la propia pantalla fijada + el recorrido horizontal.
      section.style.height = `${window.innerHeight + maxX}px`;
      update();
    };

    const update = (): void => {
      queued = false;
      if (!pinned) return;
      const rect = section.getBoundingClientRect();
      const range = rect.height - window.innerHeight;
      const p = range > 0 ? Math.min(1, Math.max(0, -rect.top / range)) : 0;
      track.style.transform = `translate3d(${(-p * maxX).toFixed(1)}px, 0, 0)`;
      setProgress(p);
    };
    const schedule = (): void => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    // Carrusel nativo: el progreso sale de su propio scroll.
    viewport.addEventListener(
      'scroll',
      () => {
        if (pinned) return;
        const range = viewport.scrollWidth - viewport.clientWidth;
        setProgress(range > 0 ? viewport.scrollLeft / range : 0);
      },
      { passive: true },
    );

    // Flechas: una foto adelante o atrás en ambos modos.
    const step = (dir: 1 | -1): void => {
      const width = items[0]?.offsetWidth ?? 300;
      if (!pinned) {
        viewport.scrollBy({ left: dir * width, behavior: 'smooth' });
        return;
      }
      const range = section.offsetHeight - window.innerHeight;
      const delta = maxX > 0 ? (width / maxX) * range : 0;
      window.scrollBy({ top: dir * delta, behavior: 'smooth' });
    };
    section.querySelector('[data-g-prev]')?.addEventListener('click', () => step(-1));
    section.querySelector('[data-g-next]')?.addEventListener('click', () => step(1));

    // Teclado en modo fijado: llevar a la vista la foto que recibe el foco.
    track.addEventListener('focusin', (e) => {
      if (!pinned) return;
      const item = (e.target as HTMLElement).closest<HTMLElement>('[data-g-item], .g-end');
      if (!item || maxX <= 0) return;
      const target = Math.min(maxX, Math.max(0, item.offsetLeft - (viewport.clientWidth - item.offsetWidth) / 2));
      const range = section.offsetHeight - window.innerHeight;
      const top = section.getBoundingClientRect().top + window.scrollY + (target / maxX) * range;
      window.scrollTo({ top, behavior: 'auto' });
    });

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    pinQuery.addEventListener('change', measure);
    // Las imágenes lazy no cambian el ancho (tamaños fijados por CSS), pero las fuentes sí pueden.
    void document.fonts?.ready.then(measure);
    measure();
  }

  /* ── Lightbox ── */
  interface Slide {
    src: string;
    alt: string;
  }
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const dataEl = dialog?.querySelector('[data-lb-data]');
  if (dialog && dataEl?.textContent) {
    const slides = JSON.parse(dataEl.textContent) as Slide[];
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number): void => {
      index = (i + slides.length) % slides.length;
      const s = slides[index];
      img.src = s.src;
      img.alt = s.alt;
      caption.textContent = s.alt;
      count.textContent = `${index + 1} / ${slides.length}`;
    };
    document.querySelectorAll<HTMLElement>('[data-gallery-open]').forEach((el) => {
      el.addEventListener('click', () => {
        opener = el;
        show(Number(el.dataset.galleryOpen) || 0);
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus({ preventScroll: true }));

    // Gesto de deslizar en móvil.
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .gallery {
    position: relative;
  }
  .g-pin {
    padding-block: var(--section-y);
  }
  .gallery.is-pinned .g-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4svh, 3rem);
    padding-block: calc(var(--nav-h) + 1rem) 2rem;
    overflow: hidden;
  }

  .g-head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .gallery.is-pinned .g-head {
    margin-bottom: 0;
  }
  .gallery.is-pinned .h2 {
    font-size: clamp(2.4rem, min(5.4vw, 9svh), 6.4rem);
  }
  .g-head .h2 {
    margin-top: 1.25rem;
  }
  .g-aside {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 38ch;
  }
  .g-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }
  .g-counter {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--c-ash-ink);
  }
  .g-counter span {
    color: var(--c-ink);
  }
  .g-bar {
    flex: 1;
    height: 2px;
    background: var(--c-line-light);
    overflow: hidden;
  }
  .g-bar i {
    display: block;
    height: 100%;
    background: var(--c-lava);
    transform: scaleX(0.04);
    transform-origin: left;
  }
  .g-nav {
    display: flex;
    gap: 0.4rem;
  }
  .g-arrow {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgb(9 9 9 / 0.3);
    border-radius: 50%;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .g-arrow:hover {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-white);
  }
  .g-arrow :global(.icon) {
    width: 20px;
  }

  /* ── Pista ── */
  .g-viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .g-viewport::-webkit-scrollbar {
    display: none;
  }
  .gallery.is-pinned .g-viewport {
    overflow: visible;
    scroll-snap-type: none;
  }
  .g-track {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.9rem, 2vw, 2rem);
    width: max-content;
    padding-inline: var(--gutter);
    will-change: transform;
  }
  .g-item {
    position: relative;
    flex: none;
    scroll-snap-align: start;
  }
  /* Alturas en función de la pantalla fijada; anchos por proporción vertical 2:3. */
  .g-item {
    --h: 46svh;
  }
  .g-item--tall {
    --h: 56svh;
  }
  .g-item--low {
    --h: 40svh;
    margin-top: 14svh;
  }
  .g-item--mid {
    --h: 48svh;
    margin-top: 4svh;
  }
  .g-item--high {
    --h: 44svh;
    margin-top: -1svh;
  }
  .g-frame {
    height: var(--h);
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--c-ink-2);
  }
  .g-btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: zoom-in;
  }
  .g-btn :global(.media) {
    transition:
      transform 1.2s var(--ease-out),
      filter 0.6s;
  }
  .g-btn:hover :global(.media),
  .g-btn:focus-visible :global(.media) {
    transform: scale(1.06);
  }
  .g-btn:focus-visible {
    outline-offset: -4px;
  }
  .g-zoom {
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--c-lava);
    color: var(--c-white);
    transform: scale(0.4);
    opacity: 0;
    transition:
      transform 0.45s var(--ease-out),
      opacity 0.3s;
  }
  .g-zoom :global(.icon) {
    width: 20px;
  }
  .g-btn:hover .g-zoom,
  .g-btn:focus-visible .g-zoom {
    transform: none;
    opacity: 1;
  }
  .g-cap {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-ash-ink);
  }
  .g-cap span {
    color: var(--c-lava-ink);
  }
  .g-drip {
    position: absolute;
    left: 10%;
    top: var(--h);
    width: 40%;
    z-index: 1;
    margin-top: -4px;
  }

  .g-end {
    flex: none;
    align-self: center;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    width: clamp(260px, 26vw, 420px);
    padding-inline: 1rem 2rem;
    scroll-snap-align: end;
  }
  .g-end-title {
    font-size: clamp(2.6rem, 1rem + 4.4vw, 5.6rem);
    font-weight: 860;
    font-stretch: var(--wd-poster);
    line-height: 0.86;
    text-transform: uppercase;
  }

  @media (max-width: 899px) {
    .g-head {
      grid-template-columns: 1fr;
    }
    .g-item,
    .g-item--tall,
    .g-item--low,
    .g-item--mid,
    .g-item--high {
      --h: min(108vw, 62svh);
      margin-top: 0;
    }
    .g-item:nth-child(even) {
      --h: min(96vw, 56svh);
      margin-top: 2.5rem;
    }
    .g-zoom {
      transform: none;
      opacity: 1;
      width: 36px;
      height: 36px;
    }
    .g-end {
      width: 78vw;
    }
  }

  /* ───────── Lightbox ───────── */
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: rgb(9 9 9 / 0.97);
    color: var(--c-white);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.4s var(--ease-out);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox::backdrop {
    background: rgb(9 9 9 / 0.9);
  }
  .lb-figure {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    max-width: 100%;
  }
  .lb-img {
    max-width: min(100%, 1100px);
    max-height: calc(100svh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lb-caption {
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    width: 100%;
    max-width: 60ch;
    color: var(--c-ash);
    font-size: var(--fs-small);
  }
  .lb-count {
    font-variant-numeric: tabular-nums;
    color: var(--c-white);
    white-space: nowrap;
  }
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    background: rgb(9 9 9 / 0.6);
    transition:
      background 0.3s,
      border-color 0.3s;
  }
  .lb-btn:hover {
    background: var(--c-lava);
    border-color: var(--c-lava);
  }
  .lb-btn :global(.icon) {
    width: 22px;
    height: 22px;
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 1rem;
  }
  .lb-next {
    right: 1rem;
  }
  @media (max-width: 699px) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>
