---
/**
 * Apertura. Una grieta de lava parte el nombre en BLACK | PORT y, al abrirse,
 * descubre la foto desde la oscuridad. Con el scroll (escritorio, escena fijada)
 * la grieta se abre hasta ocupar la pantalla y la foto pasa a dominarla.
 *
 * Capas: foto (DOM, nítida y con alt) → lienzo de magma (WebGL, interior transparente)
 * → nombre y textos. Sin WebGL o con reduced-motion: grieta estática en CSS.
 * Coreografía: scripts/motion/hero.ts.
 */
import { getImage } from 'astro:assets';
import BookingCta from '../ui/BookingCta.astro';
import MediaFrame from '../ui/MediaFrame.astro';
import Icon from '../ui/Icon.astro';
import { heroPhoto, heroVideo, hasVideo } from '@/data/media';
import { site } from '@/config/site';
import { valueOf } from '@/lib/pending';

const withVideo = hasVideo(heroVideo);
const poster = withVideo && heroPhoto.src ? await getImage({ src: heroPhoto.src, width: 853, format: 'webp' }) : undefined;
const address = valueOf(site.address);
const rating = valueOf(site.booksyRating);
const ratingUrl = valueOf(site.booksyReviewsUrl);
const place = address?.locality ?? site.island;
const ratingText = rating?.value.toLocaleString('es-ES', { minimumFractionDigits: 1 });
---

<section id="inicio" class="hero" aria-labelledby="hero-title" data-scene="hero">
  <div class="hero-stage" data-hero-stage>
    <div class="hero-photo" data-hero-photo data-intro-hide>
      <div class="hero-photo-inner photo-mono" data-hero-photo-inner>
        {
          withVideo ? (
            <video class="media" autoplay muted loop playsinline preload="metadata" poster={poster?.src} data-hero-video>
              {heroVideo.webm && <source src={heroVideo.webm} type="video/webm" />}
              {heroVideo.mp4 && <source src={heroVideo.mp4} type="video/mp4" />}
            </video>
          ) : (
            <MediaFrame photo={heroPhoto} sizes="(min-width: 900px) 67svh, 100vw" widths={[480, 853]} priority />
          )
        }
      </div>
      <div class="hero-photo-dim" data-hero-dim aria-hidden="true"></div>
    </div>

    <canvas class="hero-magma" data-magma="rift" aria-hidden="true"></canvas>

    <h1 id="hero-title" class="hero-mark" aria-label={`${site.name}, barbería en ${place}, ${site.island}`}>
      <span class="hm-half hm-a" data-hm="a" aria-hidden="true"><span class="hm-in" data-hm-in>Black</span></span>
      <span class="hm-half hm-b" data-hm="b" aria-hidden="true"><span class="hm-in" data-hm-in>port</span></span>
    </h1>

    <p class="hero-tagline" data-hero-tagline aria-hidden="true">
      <span>Más que un corte,</span>
      <span>un estilo.</span>
    </p>

    <div class="hero-info" data-hero-info>
      <div class="hero-lead" data-intro-hide>
        <p class="hero-place">Barbería en {place}, {site.island}</p>
        <p class="hero-desc">Más que un corte, un estilo. Degradados, barba a navaja y color con carácter propio.</p>
      </div>
      <div class="hero-actions" data-intro-hide>
        <div class="hero-ctas">
          <BookingCta label="Reservar cita" size="lg" placement="hero" magnetic />
          <a class="btn btn--ghost btn--lg" href="#servicios">Ver la carta</a>
        </div>
        <div class="hero-meta">
          <p class="status" data-status hidden>
            <span class="status-dot" aria-hidden="true"></span>
            <span data-status-label></span>
          </p>
          {
            rating && ratingUrl && (
              <a class="hero-rating" href={ratingUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="star" filled />
                <strong>{ratingText}</strong>
                <span>{rating.count} reseñas en Booksy</span>
                <span class="sr-only">(pestaña nueva)</span>
              </a>
            )
          }
        </div>
      </div>
    </div>

    {
      withVideo && (
        <button class="hero-pause" type="button" data-hero-toggle aria-pressed="false">
          <Icon name="pause" />
          <span class="sr-only">Pausar el vídeo de fondo</span>
        </button>
      )
    }
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sync = (): void => {
      const paused = video.paused;
      toggle?.setAttribute('aria-pressed', String(paused));
      const label = toggle?.querySelector('.sr-only');
      if (label) label.textContent = paused ? 'Reproducir el vídeo de fondo' : 'Pausar el vídeo de fondo';
    };
    if (reduce.matches) video.pause();
    toggle?.addEventListener('click', () => {
      if (video.paused) void video.play();
      else video.pause();
    });
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();
  }
</script>

<style>
  /*
   * Geometría de la grieta (también la usa hero.ts):
   *  --rift-x / --rift-y: eje de la grieta; --open: medio ancho abierto en reposo.
   * Escritorio: grieta vertical en el centro. Móvil: horizontal, entre BLACK y PORT.
   */
  .hero {
    --rift-x: 50vw;
    --open: 19svh;
    position: relative;
    background: var(--c-ink);
    color: var(--c-white);
  }
  .hero-stage {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
  }

  /* ── Foto: bajo el magma, centrada en la grieta ── */
  .hero-photo {
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: 0;
    left: var(--rift-x);
    width: calc(100svh * 2 / 3);
    min-width: calc(560px * 2 / 3);
    translate: -50% 0;
    background: radial-gradient(60% 50% at 50% 50%, #3a0508, var(--c-ink) 70%);
  }
  .hero-photo-inner {
    position: absolute;
    inset: 0;
    transform-origin: 50% 40%;
  }
  .hero-photo-inner :global(.media) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Cubre todo el ancho: al final del scroll la foto escalada desborda su caja. */
  .hero-photo-dim {
    position: absolute;
    inset: 0 calc((100% - 100vw) / 2);
    background: linear-gradient(transparent 55%, var(--c-ink)), rgb(7 7 7 / 0.35);
    opacity: 0;
    pointer-events: none;
  }

  .hero-magma {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Nombre partido ── */
  .hero-mark {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    pointer-events: none;
    font-size: clamp(5.5rem, min(12.5vw, 28svh), 16rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.8;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  .hm-half {
    position: absolute;
    top: 46%;
    display: block;
    overflow: hidden;
    padding-block: 0.08em 0.02em;
    translate: 0 -50%;
  }
  .hm-in {
    display: block;
  }
  .hm-a {
    right: calc(100% - var(--rift-x));
    padding-right: 0.06em;
    color: var(--c-bone);
    transform: translateX(calc(var(--open) * -1.15));
  }
  .hm-b {
    left: var(--rift-x);
    padding-left: 0.06em;
    color: var(--c-lava);
    transform: translateX(calc(var(--open) * 1.15));
  }

  /* Frase que aparece sobre la foto a pantalla completa (escena fijada). */
  .hero-tagline {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: var(--gutter);
    top: 50%;
    display: grid;
    justify-items: center;
    translate: 0 -50%;
    font-size: clamp(2.6rem, 1rem + 5.6vw, 7rem);
    font-weight: 300;
    font-stretch: var(--wd-wide);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .hero-tagline span:last-child {
    font-weight: 900;
    font-stretch: 62%;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--c-bone);
  }

  /* ── Información y acciones ── */
  .hero-info {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 var(--gutter) clamp(1.5rem, 4svh, 2.75rem);
    background: linear-gradient(transparent, rgb(7 7 7 / 0.75) 45%);
    padding-top: 4rem;
  }
  .hero-place {
    font-size: var(--fs-small);
    font-weight: 650;
    color: var(--c-bone);
  }
  .hero-desc {
    max-width: 36ch;
    margin-top: 0.4rem;
    color: rgb(255 255 255 / 0.72);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .hero-actions {
    display: grid;
    justify-items: end;
    gap: 0.9rem;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .hero-meta .status,
  .hero-rating {
    min-height: 40px;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--c-line-dark);
    border-radius: 999px;
    background: rgb(7 7 7 / 0.6);
  }
  .hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-small);
    transition:
      background 0.3s,
      border-color 0.3s;
  }
  .hero-rating:hover {
    background: var(--c-lava);
    border-color: var(--c-lava);
  }
  .hero-rating :global(.icon) {
    width: 15px;
    height: 15px;
    color: var(--c-lava-bright);
    transition: color 0.3s;
  }
  .hero-rating:hover :global(.icon) {
    color: var(--c-white);
  }
  .hero-rating span:not(.sr-only) {
    color: rgb(255 255 255 / 0.72);
  }

  .hero-pause {
    position: absolute;
    z-index: 3;
    right: var(--gutter);
    top: calc(var(--nav-h) + 1rem);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
  }
  .hero-pause :global(.icon) {
    width: 18px;
  }

  /* ── Grieta estática (sin WebGL o con reduced-motion) ── */
  .hero:not(.has-magma) .hero-magma {
    display: none;
  }
  .hero:not(.has-magma) .hero-photo {
    clip-path: polygon(
      calc(50% - var(--open) * 0.9) 0,
      calc(50% + var(--open) * 1.05) 0,
      calc(50% + var(--open) * 0.85) 22%,
      calc(50% + var(--open) * 1.1) 47%,
      calc(50% + var(--open) * 0.8) 71%,
      calc(50% + var(--open) * 1) 100%,
      calc(50% - var(--open) * 1.1) 100%,
      calc(50% - var(--open) * 0.85) 76%,
      calc(50% - var(--open) * 1.05) 49%,
      calc(50% - var(--open) * 0.8) 26%
    );
  }
  .hero:not(.has-magma) .hero-stage::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: 0;
    left: calc(var(--rift-x) - var(--open) * 1.6);
    width: calc(var(--open) * 3.2);
    background: radial-gradient(50% 60% at 50% 50%, rgb(204 39 49 / 0.35), transparent 70%);
    pointer-events: none;
  }

  /* Con intro: lo que entra en la coreografía empieza oculto (red de seguridad en Base). */
  :global(html.intro-on:not(.intro-done)) .hero [data-intro-hide],
  :global(html.intro-on:not(.intro-done)) .hero [data-hm-in] {
    opacity: 0;
  }

  @media (max-width: 1099px) and (min-width: 900px) {
    .hero-info {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-actions {
      justify-items: start;
    }
  }

  /* ── Móvil: grieta horizontal entre las dos mitades del nombre ── */
  @media (max-width: 899px) {
    .hero {
      --rift-y: max(35svh, 250px);
      --open: 13svh;
    }
    .hero-stage {
      min-height: 700px;
    }
    .hero-photo {
      left: 0;
      right: 0;
      top: var(--rift-y);
      bottom: auto;
      width: auto;
      min-width: 0;
      height: 150vw;
      translate: 0 -50%;
    }
    .hero-mark {
      font-size: clamp(4.6rem, 31vw, 9rem);
    }
    .hm-half {
      top: auto;
      translate: none;
    }
    .hm-a {
      left: var(--gutter);
      right: auto;
      bottom: calc(100% - var(--rift-y));
      padding-right: 0;
      transform: translateY(calc(var(--open) * -1.1));
    }
    .hm-b {
      right: var(--gutter);
      left: auto;
      top: var(--rift-y);
      padding-left: 0;
      transform: translateY(calc(var(--open) * 1.1));
    }
    .hero-info {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding-top: 3rem;
    }
    .hero-desc {
      display: none;
    }
    .hero-actions {
      justify-items: stretch;
    }
    .hero-ctas {
      justify-content: stretch;
    }
    .hero-ctas :global(.btn) {
      flex: 1 1 auto;
    }
    .hero-meta {
      justify-content: flex-start;
    }
    .hero:not(.has-magma) .hero-photo {
      clip-path: polygon(
        0 calc(50% - var(--open) * 0.9),
        26% calc(50% - var(--open) * 1.05),
        52% calc(50% - var(--open) * 0.85),
        78% calc(50% - var(--open) * 1.08),
        100% calc(50% - var(--open) * 0.9),
        100% calc(50% + var(--open) * 1.05),
        70% calc(50% + var(--open) * 0.85),
        44% calc(50% + var(--open) * 1.1),
        18% calc(50% + var(--open) * 0.88),
        0 calc(50% + var(--open))
      );
    }
    .hero:not(.has-magma) .hero-stage::before {
      left: 0;
      width: 100%;
      top: calc(var(--rift-y) - var(--open) * 1.6);
      bottom: auto;
      height: calc(var(--open) * 3.2);
    }
  }
</style>
