---
/**
 * Reseñas. Solo datos reales: la valoración publicada en Booksy (con su fecha)
 * y enlaces a las fichas de Booksy y Google. Las citas textuales solo se muestran
 * si se añaden a `src/data/reviews.ts` con permiso.
 */
import Icon from '../ui/Icon.astro';
import Pending from '../ui/Pending.astro';
import LavaSplatter from '../lava/LavaSplatter.astro';
import { reviews, SOURCE_LABEL, type ReviewSource } from '@/data/reviews';
import { site } from '@/config/site';
import { valueOf } from '@/lib/pending';

const rating = valueOf(site.booksyRating);
const sources: Array<{ id: ReviewSource; url?: string; field: string; hint: string }> = [
  { id: 'booksy', url: valueOf(site.booksyReviewsUrl), field: 'booksyReviewsUrl', hint: 'Reseñas verificadas de clientes' },
  { id: 'google', url: valueOf(site.googleReviewsUrl), field: 'googleReviewsUrl', hint: 'Opiniones en Google Maps' },
];
const monthFmt = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric' });
const dateFmt = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric' });
const ratingText = rating?.value.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

<section id="resenas" class="reviews section surface-light" aria-labelledby="reviews-title" data-scene="reviews">
  <div class="reviews-grid wrap">
    {
      rating && (
        <div class="score" role="img" aria-label={`Valoración media en Booksy: ${ratingText} de 5, con ${rating.count} reseñas`}>
          <span class="score-blob" aria-hidden="true" />
          <p class="score-num" aria-hidden="true">
            <span data-count={rating.value} data-decimals="1">
              {ratingText}
            </span>
          </p>
          <p class="score-stars" aria-hidden="true" data-reveal="rise">
            {Array.from({ length: 5 }, (_, k) => (
              <span class="star" style={`--k:${k}`}>
                <Icon name="star" filled />
              </span>
            ))}
          </p>
          <p class="score-cap" aria-hidden="true">
            {rating.count} reseñas en Booksy · {monthFmt.format(new Date(rating.asOf))}
          </p>
          <LavaSplatter class="score-splat" seed={41} />
        </div>
      )
    }

    <div class="reviews-side">
      <p class="eyebrow" data-reveal="rise"><span class="idx">(05)</span> Reseñas</p>
      <h2 id="reviews-title" class="h2" data-split="chars">
        <span class="line-mask"><span>Lo que dicen </span></span>
        <span class="line-mask"><span><span class="outline">nuestros</span> </span></span>
        <span class="line-mask"><span>clientes. </span></span>
      </h2>

      {
        reviews.length > 0 && (
          <ul class="quotes">
            {reviews.map((r) => (
              <li>
                <blockquote class="quote">
                  <p class="quote-text">{r.text}</p>
                  <footer class="quote-meta">
                    — {r.author} · {SOURCE_LABEL[r.source]}
                    {r.date && <span> · {dateFmt.format(new Date(r.date))}</span>}
                  </footer>
                </blockquote>
              </li>
            ))}
          </ul>
        )
      }

      <ul class="sources">
        {
          sources.map((src, i) => (
            <li data-reveal="mask-x" style={`--delay:${(0.1 + i * 0.12).toFixed(2)}s`}>
              {src.url ? (
                <a class="source" href={src.url} target="_blank" rel="noopener noreferrer">
                  <span class="source-name">{SOURCE_LABEL[src.id]}</span>
                  <span class="source-hint">{src.hint}</span>
                  <span class="source-go" aria-hidden="true">
                    <Icon name="arrow" />
                  </span>
                  <span class="sr-only">(pestaña nueva)</span>
                </a>
              ) : (
                <span class="source">
                  <span class="source-name">{SOURCE_LABEL[src.id]}</span>
                  <Pending label={src.field} />
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .reviews-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .score {
    position: relative;
    isolation: isolate;
  }
  /* Mancha roja tras la nota: se expande con el scroll (GSAP). */
  .score-blob {
    position: absolute;
    z-index: -1;
    left: 34%;
    top: 34%;
    width: clamp(9rem, 22vw, 22rem);
    aspect-ratio: 1;
    border-radius: 58% 42% 55% 45% / 48% 60% 40% 52%;
    background: var(--c-lava);
    transform: translate(-50%, -50%);
  }
  .score-num {
    transform-origin: 20% 80%;
  }
  .score-num {
    font-size: clamp(9rem, 4rem + 20vw, 24rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.78;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--c-ink);
  }
  .score-stars {
    display: flex;
    gap: 0.35rem;
    margin-top: 1.5rem;
  }
  .star {
    display: grid;
    place-items: center;
    width: clamp(30px, 3vw, 42px);
    aspect-ratio: 1;
    color: var(--c-lava);
  }
  .star :global(.icon) {
    width: 100%;
    height: 100%;
  }
  :global(.js) .score-stars .star {
    transform: scale(0) rotate(-40deg);
    transition: transform 0.7s var(--ease-out);
    transition-delay: calc(0.2s + var(--k) * 0.09s);
  }
  :global(.js) .score-stars:global(.is-in) .star {
    transform: none;
  }
  .score-cap {
    margin-top: 1rem;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-ash-ink);
  }
  .score-splat {
    position: absolute;
    right: 6%;
    top: -2rem;
    width: clamp(5rem, 9vw, 8rem);
  }

  .reviews-side .h2 {
    margin-top: 1.25rem;
  }
  .sources {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 2px solid var(--c-ink);
  }
  .source {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name go' 'hint go';
    align-items: center;
    column-gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--c-line-light);
  }
  .source-name {
    grid-area: name;
    font-size: clamp(1.6rem, 1rem + 2vw, 2.8rem);
    font-weight: 820;
    font-stretch: var(--wd-tight);
    line-height: 1;
    text-transform: uppercase;
    transition: transform 0.5s var(--ease-out);
  }
  .source-hint {
    grid-area: hint;
    margin-top: 0.35rem;
    color: var(--c-ash-ink);
    font-size: var(--fs-small);
  }
  .source-go {
    grid-area: go;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgb(9 9 9 / 0.3);
    border-radius: 50%;
    transition:
      background 0.35s,
      border-color 0.35s,
      color 0.35s,
      transform 0.45s var(--ease-out);
  }
  .source-go :global(.icon) {
    width: 22px;
    transform: rotate(-45deg);
    transition: transform 0.45s var(--ease-out);
  }
  a.source:hover .source-name {
    transform: translateX(8px);
  }
  a.source:hover .source-go {
    background: var(--c-lava);
    border-color: var(--c-lava);
    color: var(--c-white);
  }
  a.source:hover .source-go :global(.icon) {
    transform: none;
  }

  .quotes {
    display: grid;
    margin-top: 2rem;
  }
  .quote {
    margin: 0;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--c-line-light);
  }
  .quote-text {
    font-size: var(--fs-lead);
    line-height: 1.5;
  }
  .quote-meta {
    margin-top: 0.75rem;
    color: var(--c-ash-ink);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  @media (max-width: 899px) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }
    .reviews-side {
      order: -1;
    }
  }
</style>
