---
import MediaFrame from '../ui/MediaFrame.astro';
import BookingCta from '../ui/BookingCta.astro';
import LavaEdge from '../lava/LavaEdge.astro';
import { services, CATEGORY_ORDER, CATEGORY_TITLE, formatPrice, formatDuration } from '@/data/services';
import { servicePhotos } from '@/data/media';

const groups = CATEGORY_ORDER.map((cat) => ({ cat, items: services.filter((s) => s.category === cat) })).filter(
  (g) => g.items.length > 0,
);
const total = String(groups.length).padStart(2, '0');
---

<section id="servicios" class="services section surface-dark-2 grain" aria-labelledby="services-title" data-scene="services">
  <div class="wrap">
    <header class="services-head">
      <p class="eyebrow" data-reveal="rise"><span class="idx">(02)</span> Servicios</p>
      <h2 id="services-title" class="h2 services-title" data-split="words">
        <span class="line-mask"><span>Tu estilo, </span></span>
        <span class="line-mask"><span><span class="outline">nuestro</span> trabajo. </span></span>
      </h2>
      <p class="services-intro muted" data-reveal="rise" style="--delay:.15s">
        Del corte de cada semana al cambio de color completo. Precios y tiempos según nuestra carta en Booksy.
      </p>
    </header>

    <div class="services-body">
      <div class="services-visual" aria-hidden="true">
        <div class="sv-frame" data-reveal="frame">
          {
            groups.map((g, i) => (
              <div class:list={['sv-img', i === 0 && 'is-on']} data-sv-img={g.cat}>
                <MediaFrame photo={servicePhotos[g.cat]} sizes="(min-width: 900px) 34vw, 1px" widths={[480, 853]} />
              </div>
            ))
          }
          <span class="sv-label">
            <span class="sv-num" data-sv-num>01</span>/{total}
            <span class="sv-name" data-sv-name>{CATEGORY_TITLE[groups[0].cat]}</span>
          </span>
        </div>
        <LavaEdge
          class="sv-drip"
          seed={77}
          base={0}
          amp={0}
          width={200}
          minWidth="0px"
          fixed={[
            { t: 0.3, len: 52, w: 8 },
            { t: 0.55, len: 128, w: 13 },
            { t: 0.82, len: 80, w: 10 },
          ]}
        />
      </div>

      <div class="services-menu">
        {
          groups.map((g, gi) => (
            <section class="svc-group" data-svc-group={g.cat} data-svc-index={gi} data-svc-title={CATEGORY_TITLE[g.cat]} aria-labelledby={`svc-${g.cat}`}>
              <div class="svc-banner" aria-hidden="true">
                <MediaFrame photo={servicePhotos[g.cat]} sizes="(max-width: 899px) 92vw, 1px" widths={[480, 853]} />
              </div>
              <h3 id={`svc-${g.cat}`} class="svc-group-title" data-svc-head>
                <span class="svc-group-num">{String(gi + 1).padStart(2, '0')}</span>
                {CATEGORY_TITLE[g.cat]}
              </h3>
              <ul class="svc-list">
                {g.items.map((s) => {
                  const price = formatPrice(s);
                  const duration = formatDuration(s);
                  return (
                    <li class="svc" data-svc-row data-svc-cat={g.cat}>
                      <span class="svc-name">
                        {s.name}
                        {s.popular && <span class="svc-tag">Top</span>}
                      </span>
                      <span class="svc-lead" aria-hidden="true" />
                      <span class="svc-price">
                        <span class="sr-only">Precio: </span>
                        {price ?? '—'}
                      </span>
                      <span class="svc-meta">
                        {duration && (
                          <span class="svc-dur">
                            <span class="sr-only">Duración: </span>
                            {duration}
                          </span>
                        )}
                        {s.description && <span class="svc-desc">{s.description}</span>}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }

        <div class="services-cta" data-reveal="rise">
          <BookingCta label="Reservar en Booksy" size="lg" placement="services" magnetic />
          <p class="services-note">«Top»: los servicios más reservados. El precio final se confirma en Booksy al reservar.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // La foto fija cambia según el grupo de la carta que ocupa el centro de la pantalla.
  const imgs = document.querySelectorAll<HTMLElement>('[data-sv-img]');
  const groups = document.querySelectorAll<HTMLElement>('[data-svc-group]');
  const num = document.querySelector<HTMLElement>('[data-sv-num]');
  const name = document.querySelector<HTMLElement>('[data-sv-name]');
  if (imgs.length && groups.length && 'IntersectionObserver' in window) {
    const activate = (group: HTMLElement): void => {
      const cat = group.dataset.svcGroup;
      imgs.forEach((img) => img.classList.toggle('is-on', img.dataset.svImg === cat));
      if (num) num.textContent = String(Number(group.dataset.svcIndex) + 1).padStart(2, '0');
      if (name) name.textContent = group.dataset.svcTitle ?? '';
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) activate(e.target as HTMLElement);
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    groups.forEach((g) => io.observe(g));
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    document.querySelectorAll<HTMLElement>('[data-svc-row]').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        const group = row.closest<HTMLElement>('[data-svc-group]');
        if (fine.matches && group) activate(group);
      });
    });
  }
</script>

<style>
  .services-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    grid-template-areas: 'eyebrow eyebrow' 'title intro';
    align-items: end;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(3.5rem, 7vw, 6.5rem);
  }
  .services-head .eyebrow {
    grid-area: eyebrow;
  }
  .services-title {
    grid-area: title;
  }
  .services-intro {
    grid-area: intro;
    font-size: var(--fs-lead);
  }

  .services-body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
  }

  /* Foto fija: cambia con un fundido + leve zoom. */
  .services-visual {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }
  .sv-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - var(--nav-h) - 4rem);
    overflow: hidden;
    background: var(--c-ink);
  }
  .sv-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.9s var(--ease-liquid);
  }
  .sv-img :global(.media) {
    transform: scale(1.15);
    transition: transform 1.6s var(--ease-out);
  }
  .sv-img.is-on {
    z-index: 1;
    clip-path: inset(0 0 0 0);
  }
  .sv-img.is-on :global(.media) {
    transform: none;
  }
  .sv-label {
    z-index: 2;
  }
  .sv-label {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.5rem 0.8rem;
    background: var(--c-ink);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-ash);
  }
  .sv-num {
    color: var(--c-lava-bright);
  }
  .sv-name {
    margin-left: 0.6rem;
    color: var(--c-white);
  }
  .sv-drip {
    position: absolute;
    right: 8%;
    bottom: 0;
    width: 42%;
    transform: translateY(calc(100% - 4px));
  }

  .svc-banner {
    display: none;
  }
  .svc-group + .svc-group {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .svc-group-title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--c-white);
    font-size: clamp(1.1rem, 0.9rem + 0.7vw, 1.5rem);
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .svc-group-num {
    font-size: 0.75rem;
    color: var(--c-lava-bright);
    letter-spacing: 0.12em;
  }

  .svc {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(1.5rem, 1fr) auto;
    grid-template-areas: 'name lead price' 'meta meta meta';
    align-items: baseline;
    column-gap: 0.9rem;
    row-gap: 0.35rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--c-line-dark);
    isolation: isolate;
  }
  /* Barrido rojo muy tenue y línea de lava al pasar por encima. */
  .svc::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.4);
    z-index: -1;
    background: linear-gradient(90deg, rgb(204 39 49 / 0.16), transparent 75%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .svc::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--c-lava);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .svc:hover::before,
  .svc:hover::after {
    transform: none;
  }
  .svc-name {
    grid-area: name;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.35rem, 0.95rem + 1.4vw, 2.2rem);
    font-weight: 780;
    font-stretch: var(--wd-tight);
    line-height: 1.05;
    text-transform: uppercase;
    transition: transform 0.5s var(--ease-out);
  }
  .svc:hover .svc-name {
    transform: translateX(8px);
  }
  .svc-tag {
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: var(--c-lava);
    color: var(--c-white);
    font-size: 0.6rem;
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: 0.16em;
  }
  .svc-lead {
    grid-area: lead;
    align-self: center;
    height: 1px;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.28) 0 2px, transparent 2px 7px);
  }
  .svc-price {
    grid-area: price;
    font-size: clamp(1.35rem, 0.95rem + 1.4vw, 2.2rem);
    font-weight: 780;
    font-stretch: var(--wd-tight);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color 0.3s;
  }
  .svc:hover .svc-price {
    color: var(--c-lava-bright);
  }
  .svc-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    color: var(--c-ash);
    font-size: var(--fs-small);
  }
  .svc-dur {
    color: var(--c-white);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .svc-desc {
    max-width: 52ch;
  }

  .services-cta {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .services-note {
    max-width: 46ch;
    color: var(--c-ash);
    font-size: var(--fs-small);
  }

  @media (max-width: 899px) {
    .services-head {
      grid-template-columns: 1fr;
      grid-template-areas: 'eyebrow' 'title' 'intro';
    }
    .services-body {
      grid-template-columns: 1fr;
    }
    .services-visual {
      display: none;
    }
    .svc-banner {
      display: block;
      aspect-ratio: 16 / 7;
      margin-bottom: 1.25rem;
      overflow: hidden;
    }
    .svc-name,
    .svc-price {
      font-size: clamp(1.2rem, 0.9rem + 1.6vw, 1.6rem);
    }
    .services-cta :global(.btn) {
      width: 100%;
    }
  }
</style>
