---
/**
 * La carta, sobre ceniza. Datos: src/data/services.ts (tal como figuran en Booksy).
 * - El precio «Semanal» explica su condición antes de reservar, en una pieza propia
 *   y en cada fila afectada.
 * - Cada fila es un enlace de reserva a Booksy (el del servicio, si se conoce;
 *   si no, el perfil). Móvil: cada categoría abre con su foto.
 */
import MediaFrame from '../ui/MediaFrame.astro';
import BookingCta from '../ui/BookingCta.astro';
import { services, CATEGORY_ORDER, CATEGORY_TITLE, WEEKLY_RULE, formatPrice, formatDuration } from '@/data/services';
import { servicePhotos } from '@/data/media';
import { BOOKSY_URL } from '@/config/site';
import Icon from '../ui/Icon.astro';

const groups = CATEGORY_ORDER.map((cat) => ({ cat, items: services.filter((s) => s.category === cat) })).filter(
  (g) => g.items.length > 0,
);
/** Sin URL de Booksy confirmada, la fila no finge ser un enlace. */
const Row = BOOKSY_URL ? 'a' : 'div';
const weekly = services.filter((s) => s.weekly && s.price !== undefined);
const weeklyFrom = weekly.length ? Math.min(...weekly.map((s) => s.price as number)) : undefined;
---

<section id="servicios" class="services section surface-light" aria-labelledby="services-title" data-scene="services">
  <div class="wrap">
    <header class="services-head">
      <p class="eyebrow" data-reveal="rise">Servicios y precios</p>
      <h2 id="services-title" class="h2 services-title" data-split="words">
        <span class="line-mask"><span>Tu estilo, </span></span>
        <span class="line-mask"><span><span class="outline">nuestro</span> trabajo. </span></span>
      </h2>
      <p class="services-intro" data-reveal="rise" style="--delay:.15s">
        Precios y tiempos de nuestra carta en Booksy. El importe final se confirma al reservar.
      </p>
    </header>

    {
      weekly.length > 0 && weeklyFrom !== undefined && (
        <aside class="weekly" aria-labelledby="weekly-title" data-weekly>
          <p class="weekly-price" aria-hidden="true">
            <span class="weekly-from">desde</span>
            {weeklyFrom}
            <span class="weekly-cur">€</span>
          </p>
          <div class="weekly-body">
            <h3 id="weekly-title" class="weekly-title">Precio «Semanal»</h3>
            <p class="weekly-rule">{WEEKLY_RULE}</p>
            <ul class="weekly-list">
              {weekly.map((s) => (
                <li>
                  {s.name} <strong>{formatPrice(s)}</strong>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )
    }

    <div class="svc-groups">
      {
        groups.map((g) => (
          <section class="svc-group" data-svc-group={g.cat} aria-labelledby={`svc-${g.cat}`}>
            <div class="svc-banner photo-mono" aria-hidden="true" data-svc-banner>
              <MediaFrame photo={servicePhotos[g.cat]} sizes="(max-width: 899px) 92vw, 1px" widths={[480, 853]} />
            </div>
            <h3 id={`svc-${g.cat}`} class="svc-group-title" data-svc-head>
              {CATEGORY_TITLE[g.cat]}
            </h3>
            <ul class="svc-list">
              {g.items.map((s) => {
                const price = formatPrice(s);
                const duration = formatDuration(s);
                return (
                  <li class:list={['svc', s.weekly && 'svc--weekly']} data-svc-row>
                    <Row
                      class="svc-link"
                      href={s.bookingUrl ?? BOOKSY_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-cta="booking"
                      data-placement={`service:${s.name}`}
                    >
                    <span class="svc-name">
                      {s.name}
                      {s.popular && <span class="svc-tag">Más reservado</span>}
                    </span>
                    <span class="svc-price">
                      <span class="sr-only">Precio: </span>
                      {price ?? '—'}
                    </span>
                    <span class="svc-meta">
                      {duration && (
                        <span class="svc-dur">
                          <span class="sr-only">Duración: </span>
                          {duration}
                        </span>
                      )}
                      {s.weekly ? (
                        <span class="svc-desc svc-rule">Requisito: haberte hecho este mismo servicio la semana anterior.</span>
                      ) : (
                        s.description && <span class="svc-desc">{s.description}</span>
                      )}
                    </span>
                    {(s.bookingUrl ?? BOOKSY_URL) && (
                      <span class="svc-go" aria-hidden="true">
                        Reservar <Icon name="arrow" class="arrow" />
                      </span>
                    )}
                    {(s.bookingUrl ?? BOOKSY_URL) && <span class="sr-only">— reservar en Booksy (pestaña nueva)</span>}
                    </Row>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="services-cta" data-reveal="rise">
      <BookingCta label="Reservar en Booksy" size="lg" placement="services" magnetic />
    </div>
  </div>

</section>

<style>
  .services {
    position: relative;
    overflow-x: clip;
    /* La reserva sube por encima de este margen (frente de lava). */
    padding-bottom: calc(var(--section-y) + var(--front-rise));
  }
  .services-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    grid-template-areas: 'eyebrow eyebrow' 'title intro';
    align-items: end;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .services-head .eyebrow {
    grid-area: eyebrow;
  }
  .services-title {
    grid-area: title;
  }
  .services-intro {
    grid-area: intro;
    color: var(--c-ash-ink);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  /* ── Precio «Semanal»: pieza de obsidiana dentro de la ceniza ── */
  .weekly {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
    padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1.5rem, 4vw, 4rem);
    background: var(--c-ink);
    color: var(--c-white);
    border-radius: 2px;
    overflow: hidden;
    isolation: isolate;
  }
  /* Veta de lava en el canto: el «calor» de la oferta, sin iconos de alerta. */
  .weekly::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 6px;
    background: linear-gradient(var(--c-lava-deep), var(--c-lava) 40%, var(--c-magma));
  }
  .weekly::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: -10%;
    top: -60%;
    width: 50%;
    height: 220%;
    background: radial-gradient(closest-side, rgb(204 39 49 / 0.28), transparent);
    pointer-events: none;
  }
  .weekly-price {
    display: flex;
    align-items: baseline;
    gap: 0.15em;
    font-size: clamp(4.5rem, 2rem + 8vw, 10rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.8;
    font-variant-numeric: tabular-nums;
  }
  .weekly-from {
    align-self: flex-start;
    margin-right: 0.35em;
    font-size: 0.14em;
    font-weight: 600;
    font-stretch: 100%;
    color: var(--c-ash);
    letter-spacing: 0.02em;
  }
  .weekly-cur {
    font-size: 0.42em;
    color: var(--c-lava-bright);
  }
  .weekly-title {
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.2rem);
    font-weight: 820;
    font-stretch: var(--wd-tight);
    line-height: 1;
    text-transform: uppercase;
  }
  .weekly-rule {
    max-width: 48ch;
    margin-top: 0.8rem;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--c-white);
  }
  .weekly-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1rem;
    color: var(--c-ash);
    font-size: var(--fs-small);
  }
  .weekly-list strong {
    margin-left: 0.3em;
    color: var(--c-white);
  }

  /* ── Carta ── */
  .svc-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 5vw, 4.5rem) clamp(2rem, 5vw, 5.5rem);
  }
  .svc-banner {
    display: none;
  }
  .svc-group-title {
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--c-ink);
    font-size: clamp(1.6rem, 1rem + 1.8vw, 2.6rem);
    font-weight: 880;
    font-stretch: var(--wd-poster);
    line-height: 1;
    text-transform: uppercase;
  }
  .svc {
    position: relative;
    border-bottom: 1px solid var(--c-line-light);
  }
  .svc-link {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name price' 'meta go';
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.35rem;
    padding-block: 1.05rem;
    color: inherit;
    text-decoration: none;
    isolation: isolate;
  }
  a.svc-link {
    cursor: pointer;
  }
  a.svc-link:focus-visible {
    outline: 2px solid var(--c-lava-ink);
    outline-offset: 4px;
  }
  /* Raya de lava que recorre la fila al pasar por encima. */
  .svc::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--c-lava);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .svc:has(a:hover)::after,
  .svc:has(a:focus-visible)::after {
    transform: none;
  }
  .svc-name {
    grid-area: name;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-size: clamp(1.15rem, 0.9rem + 0.8vw, 1.6rem);
    font-weight: 760;
    font-stretch: var(--wd-tight);
    line-height: 1.1;
    text-transform: uppercase;
    transition: transform 0.5s var(--ease-out);
  }
  a.svc-link:hover .svc-name,
  a.svc-link:focus-visible .svc-name {
    transform: translateX(6px);
  }
  .svc-tag {
    padding: 0.28rem 0.55rem;
    border: 1px solid var(--c-lava-ink);
    border-radius: 999px;
    color: var(--c-lava-ink);
    font-size: 0.62rem;
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: 0.04em;
    text-transform: none;
  }
  .svc-price {
    grid-area: price;
    justify-self: end;
    font-size: clamp(1.15rem, 0.9rem + 0.8vw, 1.6rem);
    font-weight: 800;
    font-stretch: var(--wd-tight);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color 0.3s;
  }
  a.svc-link:hover .svc-price,
  a.svc-link:focus-visible .svc-price {
    color: var(--c-lava-ink);
  }
  /* «Reservar →»: aparece al pasar (escritorio); en táctil, siempre visible. */
  .svc-go {
    grid-area: go;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: end;
    color: var(--c-lava-ink);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .svc-go :global(.arrow) {
    width: 14px;
    height: 14px;
  }
  a.svc-link:hover .svc-go,
  a.svc-link:focus-visible .svc-go {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .svc-go {
      opacity: 1;
      transform: none;
    }
  }
  .svc-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    color: var(--c-ash-ink);
    font-size: var(--fs-small);
  }
  .svc-dur {
    color: var(--c-ink);
    font-weight: 600;
  }
  .svc-desc {
    max-width: 52ch;
  }
  .svc-rule {
    color: var(--c-lava-ink);
    font-weight: 600;
  }

  .services-cta {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  @media (max-width: 899px) {
    .services-head {
      grid-template-columns: 1fr;
      grid-template-areas: 'eyebrow' 'title' 'intro';
    }
    .weekly {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .svc-groups {
      grid-template-columns: 1fr;
    }
    .svc-banner {
      display: block;
      aspect-ratio: 16 / 9;
      margin-bottom: 1.25rem;
      overflow: hidden;
    }
    .svc-banner :global(.media) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .services-cta :global(.btn) {
      width: 100%;
    }
  }
</style>
