---
/**
 * Ubicación y contacto. Solo se enlazan canales confirmados.
 * El relieve es una ilustración: el marcador indica el local, el mapa real se abre en Google Maps.
 */
import Icon, { type IconName } from '../ui/Icon.astro';
import Pending from '../ui/Pending.astro';
import { site, BOOKSY_URL } from '@/config/site';
import { valueOf, SHOW_PENDING } from '@/lib/pending';
import { groupHours } from '@/lib/hours';
import { contours } from '@/lib/lava';

const address = valueOf(site.address);
const geo = valueOf(site.geo);
const mapsUrl = valueOf(site.mapsUrl);
const hours = valueOf(site.hours);
const phone = valueOf(site.phone);
const email = valueOf(site.email);
const instagram = valueOf(site.instagram);
const amenities = valueOf(site.amenities);

interface Channel {
  icon: IconName;
  label: string;
  value?: string;
  href?: string;
  external?: boolean;
  pendingKey: string;
}

const channels: Channel[] = [
  { icon: 'phone', label: 'Teléfono', value: phone?.display, href: phone && `tel:${phone.e164}`, pendingKey: 'phone' },
  { icon: 'instagram', label: 'Instagram', value: instagram && `@${instagram.handle}`, href: instagram?.url, external: true, pendingKey: 'instagram' },
  { icon: 'calendar', label: 'Booksy', value: BOOKSY_URL && 'Reservar cita', href: BOOKSY_URL, external: true, pendingKey: 'booksyUrl' },
  { icon: 'mail', label: 'Email', value: email, href: email && `mailto:${email}`, pendingKey: 'email' },
];
const visibleChannels = channels.filter((c) => c.href || SHOW_PENDING);
const relief = contours(1706, 600, 12);
const coords = geo && `${Math.abs(geo.lat).toFixed(4)}° N · ${Math.abs(geo.lng).toFixed(4)}° O`;
---

<section id="visitanos" class="visit section surface-dark" aria-labelledby="visit-title" data-scene="visit">
  <div class="visit-grid wrap">
    <header class="visit-head">
      <p class="eyebrow" data-reveal="rise"><span class="idx">(06)</span> Visítanos</p>
      <h2 id="visit-title" class="h2" data-split="chars">
        <span class="line-mask"><span>Ven a </span></span>
        <span class="line-mask"><span><span class="outline">vernos.</span> </span></span>
      </h2>
    </header>

    <div class="visit-info">
      {
        address ? (
          <address class="visit-address" data-reveal="rise">
            <span>{address.street}</span>
            <span>
              {address.postalCode} {address.locality}
            </span>
            <span class="muted">{address.region}</span>
          </address>
        ) : (
          SHOW_PENDING && <Pending label="dirección exacta" />
        )
      }

      <div class="visit-actions" data-reveal="rise" style="--delay:.1s">
        {
          mapsUrl && (
            <a class="btn btn--lava" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              Cómo llegar <Icon name="arrow" class="arrow" />
              <span class="sr-only">(abre Google Maps en una pestaña nueva)</span>
            </a>
          )
        }
        {
          phone && (
            <a class="btn btn--ghost" href={`tel:${phone.e164}`}>
              <Icon name="phone" class="arrow" /> Llamar
            </a>
          )
        }
      </div>

      <dl class="facts">
        {
          (hours || SHOW_PENDING) && (
            <div class="fact" data-reveal="rise" style="--delay:.15s">
              <dt>
                <Icon name="clock" /> Horario
                <span class="status" data-status hidden>
                  <span class="status-dot" aria-hidden="true" />
                  <span data-status-label />
                </span>
              </dt>
              <dd>
                {hours ? (
                  <ul class="hours-compact">
                    {groupHours(hours).map((g) => (
                      <li>
                        <span>{g.days}</span>
                        <span>{g.slots}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <Pending label="horario" />
                )}
              </dd>
            </div>
          )
        }
        {
          amenities && amenities.length > 0 && (
            <div class="fact" data-reveal="rise" style="--delay:.25s">
              <dt>
                <Icon name="plus" /> Bueno saber
              </dt>
              <dd>
                <ul class="amenities">
                  {amenities.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    {
      mapsUrl ? (
        <a class="relief" href={mapsUrl} target="_blank" rel="noopener noreferrer" data-reveal="frame">
          <svg viewBox="0 0 600 600" aria-hidden="true" focusable="false">
            {relief.map((d, i) => (
              <path
                class="contour"
                d={d}
                fill="none"
                stroke={i === relief.length - 4 ? 'var(--c-lava)' : 'rgb(255 255 255 / .16)'}
                stroke-width={i === relief.length - 4 ? 1.6 : 1}
              />
            ))}
          </svg>
          <span class="pin" aria-hidden="true" data-pin>
            <Icon name="pin" />
          </span>
          <span class="relief-label">
            <strong>{site.name}</strong>
            {address && <span>{address.locality} · {site.island}</span>}
          </span>
          {coords && <span class="relief-coords" aria-hidden="true">{coords}</span>}
          <span class="relief-open" aria-hidden="true">
            Abrir mapa <Icon name="arrow" />
          </span>
          <span class="sr-only">Ver la ubicación de {site.name} en Google Maps (pestaña nueva)</span>
        </a>
      ) : (
        <figure class="relief" aria-hidden="true" data-reveal="frame">
          <svg viewBox="0 0 600 600" focusable="false">
            {relief.map((d) => (
              <path d={d} fill="none" stroke="rgb(255 255 255 / .16)" stroke-width="1" />
            ))}
          </svg>
        </figure>
      )
    }

    {
      visibleChannels.length > 0 && (
        <ul class="channels">
          {visibleChannels.map((c, i) => (
            <li data-reveal="rise" style={`--delay:${(i * 0.06).toFixed(2)}s`}>
              {c.href ? (
                <a class="channel" href={c.href} {...(c.external && { target: '_blank', rel: 'noopener noreferrer' })}>
                  <span class="ch-icon">
                    <Icon name={c.icon} />
                  </span>
                  <span class="ch-text">
                    <span class="ch-label">{c.label}</span>
                    <span class="ch-value">{c.value}</span>
                  </span>
                  {c.external && <span class="sr-only">(pestaña nueva)</span>}
                </a>
              ) : (
                <span class="channel channel--pending">
                  <span class="ch-icon">
                    <Icon name={c.icon} />
                  </span>
                  <span class="ch-text">
                    <span class="ch-label">{c.label}</span>
                    <Pending label={c.pendingKey} />
                  </span>
                </span>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .visit-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2.5rem, 5vw, 4rem);
  }
  .visit-head {
    grid-column: 1 / span 6;
  }
  .visit-head .h2 {
    margin-top: 1.25rem;
    font-size: clamp(3rem, 1rem + 7vw, 8.5rem);
  }
  .visit-info {
    grid-column: 1 / span 6;
    grid-row: 2;
    display: grid;
    gap: 2rem;
    align-content: start;
    justify-items: start;
  }
  .visit-address {
    display: grid;
    font-style: normal;
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.4rem);
    font-weight: 760;
    font-stretch: var(--wd-tight);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .visit-address .muted {
    margin-top: 0.4rem;
    font-size: var(--fs-small);
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0.16em;
  }
  .visit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .facts {
    display: grid;
    gap: 1.75rem;
    width: 100%;
    margin: 0.5rem 0 0;
  }
  .fact dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ash);
  }
  .fact dt :global(.icon) {
    width: 18px;
    color: var(--c-lava-bright);
  }
  .fact dt .status {
    margin-left: auto;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--c-white);
  }
  .fact dd {
    margin: 0;
  }
  .hours-compact li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--c-line-dark);
    font-size: var(--fs-small);
  }
  .hours-compact li span:first-child {
    color: var(--c-ash);
  }
  .hours-compact li span:last-child {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .amenities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .amenities li {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--c-line-dark);
    border-radius: 999px;
    font-size: var(--fs-small);
  }

  /* ── Relieve con marcador ── */
  .relief {
    position: relative;
    grid-column: 8 / span 5;
    grid-row: 1 / span 2;
    align-self: start;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgb(204 39 49 / 0.16), transparent 60%),
      var(--c-ink-2);
    border: 1px solid var(--c-line-dark);
  }
  .relief svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform 1.4s var(--ease-out);
  }
  a.relief:hover svg {
    transform: scale(1.08) rotate(-2deg);
  }
  .pin {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: -52px 0 0 -26px;
    border-radius: 50% 50% 50% 0;
    background: var(--c-lava);
    transform: rotate(-45deg);
    box-shadow: 0 10px 30px rgb(204 39 49 / 0.45);
  }
  .pin :global(.icon) {
    width: 22px;
    transform: rotate(45deg);
  }
  .pin::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--c-lava);
    transform: translate(-50%, 50%) rotate(45deg);
    animation: ping 2.4s var(--ease-out) infinite;
  }
  .relief-label {
    position: absolute;
    left: 50%;
    top: calc(50% + 1.2rem);
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    transform: translateX(-50%);
    text-align: center;
    white-space: nowrap;
    font-size: var(--fs-small);
  }
  .relief-label strong {
    font-size: 1.1rem;
    font-weight: 820;
    font-stretch: var(--wd-tight);
    letter-spacing: 0.04em;
  }
  .relief-label span {
    color: var(--c-ash);
  }
  .relief-coords,
  .relief-open {
    position: absolute;
    bottom: 1rem;
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ash);
  }
  .relief-coords {
    left: 1.2rem;
  }
  .relief-open {
    right: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-white);
  }
  .relief-open :global(.icon) {
    width: 18px;
    transition: transform 0.4s var(--ease-out);
  }
  a.relief:hover .relief-open :global(.icon) {
    transform: translateX(5px);
  }

  /* ── Canales ── */
  .channels {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-top: 1px solid var(--c-line-dark);
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 76px;
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--c-line-dark);
  }
  .ch-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--c-line-dark);
    border-radius: 50%;
    transition:
      background 0.3s,
      border-color 0.3s,
      transform 0.45s var(--ease-out);
  }
  .ch-icon :global(.icon) {
    width: 18px;
  }
  a.channel:hover .ch-icon {
    background: var(--c-lava);
    border-color: var(--c-lava);
    transform: rotate(-12deg) scale(1.06);
  }
  .ch-text {
    display: grid;
    gap: 0.2rem;
    justify-items: start;
  }
  .ch-label {
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ash);
  }
  .ch-value {
    font-weight: 650;
  }

  @media (max-width: 899px) {
    .visit-head,
    .visit-info {
      grid-column: 1 / -1;
    }
    .relief {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }
    .visit-actions {
      width: 100%;
    }
    .visit-actions :global(.btn) {
      flex: 1 1 auto;
    }
  }
</style>
