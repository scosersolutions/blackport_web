---
/**
 * Ubicación y contacto. Solo se enlazan canales confirmados.
 * Mapa real: OpenStreetMap incrustado (sin claves ni cookies de seguimiento), en tono
 * obsidiana. Queda «dormido» tras un escudo hasta que se activa, para que el scroll
 * de la página no se quede atrapado en él (sobre todo en móvil).
 * «Cómo llegar» abre la ruta en Google Maps hacia la dirección confirmada.
 */
import Icon, { type IconName } from '../ui/Icon.astro';
import Pending from '../ui/Pending.astro';
import { site, BOOKSY_URL } from '@/config/site';
import { valueOf, SHOW_PENDING } from '@/lib/pending';
import { groupHours } from '@/lib/hours';

const address = valueOf(site.address);
const geo = valueOf(site.geo);
const mapsUrl = valueOf(site.mapsUrl);
const hours = valueOf(site.hours);
const phone = valueOf(site.phone);
const email = valueOf(site.email);
const instagram = valueOf(site.instagram);
const amenities = valueOf(site.amenities);

const fullAddress = address && `${address.street}, ${address.postalCode} ${address.locality}, ${address.region}`.replace(/ /g, ' ');
const directionsUrl = fullAddress && `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;
// Encuadre ~calle a calle alrededor del local.
const mapSrc =
  geo &&
  `https://www.openstreetmap.org/export/embed.html?bbox=${[geo.lng - 0.0042, geo.lat - 0.0024, geo.lng + 0.0042, geo.lat + 0.0024]
    .map((n) => n.toFixed(5))
    .join('%2C')}&layer=mapnik&marker=${geo.lat.toFixed(6)}%2C${geo.lng.toFixed(6)}`;
const osmUrl = geo && `https://www.openstreetmap.org/?mlat=${geo.lat.toFixed(6)}&mlon=${geo.lng.toFixed(6)}#map=18/${geo.lat.toFixed(5)}/${geo.lng.toFixed(5)}`;

interface Channel {
  icon: IconName;
  label: string;
  value?: string;
  href?: string;
  external?: boolean;
  pendingKey: string;
}

const channels: Channel[] = [
  { icon: 'phone', label: 'Teléfono', value: phone?.display, href: phone && `tel:${phone.e164}`, pendingKey: 'phone' },
  { icon: 'instagram', label: 'Instagram', value: instagram && `@${instagram.handle}`, href: instagram?.url, external: true, pendingKey: 'instagram' },
  { icon: 'calendar', label: 'Booksy', value: BOOKSY_URL && 'Reservar cita', href: BOOKSY_URL, external: true, pendingKey: 'booksyUrl' },
  { icon: 'mail', label: 'Email', value: email, href: email && `mailto:${email}`, pendingKey: 'email' },
];
const visibleChannels = channels.filter((c) => c.href || SHOW_PENDING);
---

<section id="visitanos" class="visit section surface-dark" aria-labelledby="visit-title" data-scene="visit">
  <div class="visit-grid wrap">
    <header class="visit-head">
      <p class="eyebrow" data-reveal="rise">Dónde estamos</p>
      <h2 id="visit-title" class="h2" data-split="chars">
        <span class="line-mask"><span>Ven a </span></span>
        <span class="line-mask"><span><span class="outline">vernos.</span> </span></span>
      </h2>
    </header>

    <div class="visit-info">
      {
        address ? (
          <address class="visit-address">
            <span class="va-line">{address.street}</span>
            <span class="va-line">
              {address.postalCode} {address.locality}
            </span>
            <span class="va-region">{address.region}</span>
          </address>
        ) : (
          SHOW_PENDING && <Pending label="dirección exacta" />
        )
      }

      <div class="visit-actions" data-reveal="rise" style="--delay:.1s">
        {
          directionsUrl && (
            <a class="btn btn--lava" href={directionsUrl} target="_blank" rel="noopener noreferrer">
              Cómo llegar <Icon name="arrow" class="arrow" />
              <span class="sr-only">(ruta en Google Maps, pestaña nueva)</span>
            </a>
          )
        }
        {
          phone && (
            <a class="btn btn--ghost" href={`tel:${phone.e164}`}>
              <Icon name="phone" class="arrow" /> Llamar
            </a>
          )
        }
      </div>

      <dl class="facts">
        {
          (hours || SHOW_PENDING) && (
            <div class="fact" data-reveal="rise" style="--delay:.15s">
              <dt>
                <Icon name="clock" /> Horario
                <span class="status" data-status hidden>
                  <span class="status-dot" aria-hidden="true" />
                  <span data-status-label />
                </span>
              </dt>
              <dd>
                {hours ? (
                  <ul class="hours-compact">
                    {groupHours(hours).map((g) => (
                      <li>
                        <span>{g.days}</span>
                        <span>{g.slots}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <Pending label="horario" />
                )}
              </dd>
            </div>
          )
        }
        {
          amenities && amenities.length > 0 && (
            <div class="fact" data-reveal="rise" style="--delay:.25s">
              <dt>
                <Icon name="plus" /> Bueno saber
              </dt>
              <dd>
                <ul class="amenities">
                  {amenities.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    {
      mapSrc ? (
        <figure class="map" data-map>
          <div class="map-window" data-map-window>
            <iframe
              class="map-frame"
              title={`Mapa: ubicación de ${site.name} en ${address?.locality ?? site.island}`}
              src={mapSrc}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              tabindex="-1"
              data-map-frame
            />
            <button class="map-shield" type="button" data-map-activate>
              <span class="map-pin" aria-hidden="true">
                <Icon name="pin" />
              </span>
              <span class="map-hint">Explorar el mapa</span>
            </button>
          </div>
          <figcaption class="map-cap">
            <span>
              {address?.locality}, {site.island}
            </span>
            <span class="map-links">
              {mapsUrl && (
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer">
                  Google Maps
                  <span class="sr-only">(ficha del local, pestaña nueva)</span>
                </a>
              )}
              {osmUrl && (
                <a href={osmUrl} target="_blank" rel="noopener noreferrer">
                  OpenStreetMap
                  <span class="sr-only">(pestaña nueva)</span>
                </a>
              )}
            </span>
          </figcaption>
        </figure>
      ) : (
        SHOW_PENDING && <Pending label="coordenadas del local" />
      )
    }

    {
      visibleChannels.length > 0 && (
        <ul class="channels">
          {visibleChannels.map((c, i) => (
            <li data-reveal="rise" style={`--delay:${(i * 0.06).toFixed(2)}s`}>
              {c.href ? (
                <a class="channel" href={c.href} {...(c.external && { target: '_blank', rel: 'noopener noreferrer' })}>
                  <span class="ch-icon">
                    <Icon name={c.icon} />
                  </span>
                  <span class="ch-text">
                    <span class="ch-label">{c.label}</span>
                    <span class="ch-value">{c.value}</span>
                  </span>
                  {c.external && <span class="sr-only">(pestaña nueva)</span>}
                </a>
              ) : (
                <span class="channel channel--pending">
                  <span class="ch-icon">
                    <Icon name={c.icon} />
                  </span>
                  <span class="ch-text">
                    <span class="ch-label">{c.label}</span>
                    <Pending label={c.pendingKey} />
                  </span>
                </span>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<script>
  // Activar el mapa: retira el escudo y le da el foco.
  const map = document.querySelector<HTMLElement>('[data-map]');
  const shield = map?.querySelector<HTMLButtonElement>('[data-map-activate]');
  const frame = map?.querySelector<HTMLIFrameElement>('[data-map-frame]');
  if (map && shield && frame) {
    shield.addEventListener('click', () => {
      map.classList.add('is-live');
      frame.removeAttribute('tabindex');
      frame.focus();
    });
  }
</script>

<style>
  .visit-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2.5rem, 5vw, 4rem);
  }
  .visit-head {
    grid-column: 1 / span 6;
  }
  .visit-head .h2 {
    margin-top: 1.25rem;
    font-size: clamp(3rem, 1rem + 7vw, 8.5rem);
  }
  .visit-info {
    grid-column: 1 / span 5;
    grid-row: 2;
    display: grid;
    gap: 2rem;
    align-content: start;
    justify-items: start;
  }
  .visit-address {
    display: grid;
    font-style: normal;
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.4rem);
    font-weight: 780;
    font-stretch: var(--wd-tight);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .va-line {
    display: block;
  }
  .va-region {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    font-weight: 600;
    font-stretch: 100%;
    text-transform: none;
    color: var(--c-ash);
  }
  .visit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .facts {
    display: grid;
    gap: 1.75rem;
    width: 100%;
    margin: 0.5rem 0 0;
  }
  .fact dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--c-white);
  }
  .fact dt :global(.icon) {
    width: 18px;
    color: var(--c-lava-bright);
  }
  .fact dt .status {
    margin-left: auto;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .fact dd {
    margin: 0;
  }
  .hours-compact li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--c-line-dark);
    font-size: var(--fs-small);
  }
  .hours-compact li span:first-child {
    color: var(--c-ash);
  }
  .hours-compact li span:last-child {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .amenities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .amenities li {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--c-line-dark);
    border-radius: 999px;
    font-size: var(--fs-small);
  }

  /* ── Mapa ── */
  .map {
    grid-column: 7 / -1;
    grid-row: 1 / span 2;
    align-self: stretch;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.9rem;
    min-height: 34rem;
  }
  .map-window {
    position: relative;
    overflow: hidden;
    background: var(--c-ink-2);
    border: 1px solid var(--c-line-dark);
    clip-path: inset(0 0 0 0 round 2px);
  }
  /* Tono obsidiana: el mapa claro se invierte y se desatura (no se toca su contenido). */
  .map-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) invert(0.92) contrast(0.92) brightness(0.92);
    pointer-events: none;
  }
  .map.is-live .map-frame {
    pointer-events: auto;
  }
  .map-shield {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    background: radial-gradient(circle at 50% 50%, transparent 0, transparent 22%, rgb(7 7 7 / 0.35) 75%);
    transition: opacity 0.4s var(--ease-out);
  }
  .map.is-live .map-shield {
    opacity: 0;
    visibility: hidden;
  }
  /* Marcador de lava sobre la posición exacta (el centro del encuadre). */
  .map-pin {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: -52px 0 0 -26px;
    border-radius: 50% 50% 50% 0;
    background: var(--c-lava);
    color: var(--c-white);
    transform: rotate(-45deg);
    box-shadow: 0 10px 30px rgb(204 39 49 / 0.5);
  }
  .map-pin :global(.icon) {
    width: 22px;
    transform: rotate(45deg);
  }
  .map-pin::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--c-lava-bright);
    transform: translate(-50%, 50%) rotate(45deg);
    animation: ping 2.4s var(--ease-out) infinite;
  }
  .map-hint {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    background: rgb(7 7 7 / 0.8);
    border: 1px solid var(--c-line-dark);
    font-size: var(--fs-small);
    font-weight: 650;
    white-space: nowrap;
    transition: background 0.3s;
  }
  .map-shield:hover .map-hint,
  .map-shield:focus-visible .map-hint {
    background: var(--c-lava);
  }
  .map-shield:focus-visible {
    outline-offset: -4px;
  }
  .map-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    color: var(--c-ash);
    font-size: var(--fs-small);
  }
  .map-links {
    display: flex;
    gap: 1.25rem;
  }
  .map-links a {
    color: var(--c-white);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: var(--c-lava);
    text-underline-offset: 0.3em;
  }
  .map-links a:hover {
    color: var(--c-lava-bright);
  }

  /* ── Canales ── */
  .channels {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-top: 1px solid var(--c-line-dark);
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 76px;
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--c-line-dark);
  }
  .ch-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--c-line-dark);
    border-radius: 50%;
    transition:
      background 0.3s,
      border-color 0.3s,
      transform 0.45s var(--ease-out);
  }
  .ch-icon :global(.icon) {
    width: 18px;
  }
  a.channel:hover .ch-icon {
    background: var(--c-lava);
    border-color: var(--c-lava);
    transform: rotate(-12deg) scale(1.06);
  }
  .ch-text {
    display: grid;
    gap: 0.2rem;
    justify-items: start;
  }
  .ch-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-ash);
  }
  .ch-value {
    font-weight: 650;
  }

  @media (max-width: 899px) {
    .visit-head,
    .visit-info {
      grid-column: 1 / -1;
    }
    .map {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 0;
    }
    .map-window {
      aspect-ratio: 4 / 5;
    }
    .visit-actions {
      width: 100%;
    }
    .visit-actions :global(.btn) {
      flex: 1 1 auto;
    }
  }
</style>
