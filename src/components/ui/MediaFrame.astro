---
/**
 * Fotografía optimizada (AVIF/WebP, varios anchos) o, si falta el archivo,
 * un placeholder de desarrollo claramente etiquetado. En producción, una foto
 * sin archivo no renderiza nada: la sección decide su composición alternativa.
 */
import { Picture } from 'astro:assets';
import { CATEGORY_LABEL, type Photo } from '@/data/media';
import { SHOW_PENDING } from '@/lib/pending';
import { scopeAttrs } from '@/lib/scope';

interface Props {
  photo: Photo;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  /** Escala de grises por defecto (dirección fotográfica). Desactivar en fotos de color con carácter. */
  mono?: boolean;
}

const { photo, sizes, widths = [480, 768, 1080, 1440], priority = false, class: className, mono = false } = Astro.props;
const focus = photo.focus ?? '50% 40%';
const scope = scopeAttrs(Astro.props);
---

{
  photo.src ? (
    <Picture
      src={photo.src}
      alt={photo.alt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      class:list={['media', mono && 'media--mono', className]}
      style={`object-position:${focus}`}
      {...scope}
    />
  ) : (
    SHOW_PENDING && (
      <div class:list={['media', 'media--placeholder', className]} role="img" aria-label={`Placeholder: ${photo.alt}`} {...scope}>
        <span class="ph-cat">{CATEGORY_LABEL[photo.category]}</span>
        <span class="ph-alt">{photo.alt}</span>
        <span class="pending-tag">Pendiente · foto {photo.id}</span>
      </div>
    )
  )
}

<style>
  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media--mono {
    filter: grayscale(1) contrast(1.08);
  }
  .media--placeholder {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: clamp(0.9rem, 2vw, 1.4rem);
    color: rgb(255 255 255 / 0.62);
    background:
      radial-gradient(120% 80% at 70% 15%, rgb(255 255 255 / 0.07), transparent 60%),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 14px),
      #141414;
    overflow: hidden;
  }
  .ph-cat {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
  }
  .ph-alt {
    font-size: 0.85rem;
    line-height: 1.35;
    max-width: 26ch;
  }
  .media--placeholder .pending-tag {
    align-self: flex-start;
  }
</style>
